{
  "name": "termauto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IDE-style terminal autocomplete for JS/RN/iOS/Android stacks, built on a fork of microsoft/inshellisense",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build:specs": "tsc -p specs/tsconfig.json && node specs/build-index.mjs",
    "refresh": "node specs/refresh/drift.mjs",
    "patches": "node scripts/export-patches.mjs",
    "test:vendor": "cd vendor/inshellisense && npm test",
    "verify": "node scripts/verify.mjs",
    "shell-init": "node scripts/shell-init.mjs",
    "diagnose": "node scripts/diagnose.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@withfig/autocomplete-types": "^1.28.0",
    "typescript": "^5.2.2"
  }
}
