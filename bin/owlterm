#!/usr/bin/env bash
# owlterm — launcher for the vendored inshellisense engine.
#
# Deliberately thin. The COMMAND is branded `owlterm`; the on-disk locations are
# not, because renaming those means touching utils/constants.ts and
# utils/config.ts and manufacturing upstream merge conflicts for cosmetic gain.
# So config still lives at the upstream location:
#   config: ~/.config/inshellisense/rc.toml   (or ~/.inshellisenserc)
#   data:   ~/.inshellisense/   (specs, generated init scripts, frecency history)
#
# Note: cwd is passed through untouched — the completion engine resolves
# generators relative to the user's current directory, so changing it here would
# silently break every cwd-sensitive completion (package.json scripts, schemes).
set -euo pipefail

# Resolve symlinks before deriving ROOT. This script is normally reached through a
# symlink (~/.local/bin/owlterm, which the generated shell init invokes by bare
# name), and without resolving it ROOT would point at the symlink's directory
# instead of the checkout. Done as a loop rather than `readlink -f` for portability.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  TARGET="$(readlink "$SELF")"
  # A relative link target is relative to the link's own directory.
  [[ "$TARGET" == /* ]] && SELF="$TARGET" || SELF="$(dirname "$SELF")/$TARGET"
done

ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
ENTRY="$ROOT/vendor/inshellisense/build/index.js"
DEFAULT_CONFIG="$ROOT/owlterm.config.json"
UPDATE_CHECK="$ROOT/scripts/check-update.mjs"
UPDATE="$ROOT/scripts/update.mjs"

if [[ ! -f "$ENTRY" ]]; then
  echo "owlterm: engine not built. Run: npm run setup" >&2
  exit 1
fi

# Two things read this: commander, for the name it prints in usage and errors;
# and getShellConfig, for the bare name it bakes into the generated init scripts
# under ~/.inshellisense/init/. Exporting it here means those scripts are always
# regenerated pointing at `owlterm`, never at upstream's `is`.
export ISTERM_LAUNCHER="owlterm"
export OWLTERM_DEFAULT_CONFIG="$DEFAULT_CONFIG"

# The engine's own version string is a `__VERSION__` placeholder that only
# upstream's single-executable packaging substitutes, so under a plain tsc build
# `--version` has nothing real to print. Supply ours. sed rather than node: this
# runs on every shell start, and a second node process just to read JSON is not
# worth it. A malformed package.json simply leaves it unset, which is harmless.
ISTERM_VERSION="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/package.json" 2>/dev/null | head -1)"
[[ -n "$ISTERM_VERSION" ]] && export ISTERM_VERSION || unset ISTERM_VERSION

refresh_resources_if_needed() {
  [[ -n "${ISTERM_VERSION:-}" ]] || return 0

  local version_file="${HOME:-}/.inshellisense/version.txt"
  local unpacked_version=""
  if [[ -f "$version_file" ]]; then
    unpacked_version="$(tr -d '\r\n' < "$version_file" 2>/dev/null || true)"
  fi
  [[ "$unpacked_version" == "$ISTERM_VERSION" ]] && return 0

  # In a plain tsc build, unpacking must run from the engine checkout so bundled
  # shell files and specs resolve from vendor/inshellisense. Call unpackResources
  # directly instead of `reinit`, which deletes the old resource tree first.
  if ! (
    cd "$(dirname "$ENTRY")/.." || exit 1
    node --input-type=module -e 'import { unpackResources } from "./build/utils/node.js"; await unpackResources();'
  ); then
    echo "owlterm: resources out of date and automatic reinit failed. Run: owlterm reinit" >&2
    exit 1
  fi
}

case "${1:-}" in
  update)
    exec node "$UPDATE" "$ROOT"
    ;;
esac

should_check_updates=true
for arg in "$@"; do
  case "$arg" in
    --)
      break
      ;;
    -c | --check | -v | --version | -h | --help)
      should_check_updates=false
      break
      ;;
    init | reinit | complete | specs | doctor | alias | uninstall | update)
      should_check_updates=false
      break
      ;;
  esac
done
if [[ "$should_check_updates" == true && -t 2 && "${OWLTERM_UPDATE_CHECK:-1}" != "0" && -f "$UPDATE_CHECK" ]]; then
  # Do not make a new terminal wait on GitHub or DNS. The helper has its own
  # timeout and cache; run it beside startup so a cold check cannot block prompt.
  (OWLTERM_UPDATE_OUTPUT=/dev/tty node "$UPDATE_CHECK" "$ROOT" </dev/null >/dev/null 2>/dev/null || true) &
fi

if [[ "$should_check_updates" == true ]]; then
  refresh_resources_if_needed
fi

# `init` and `reinit` call unpackResources(), which in a non-SEA build reads
# `process.cwd()/shell` and `process.cwd()/node_modules/@withfig/autocomplete/build`.
# They only work with cwd = the engine checkout. Every other subcommand — above all
# a real session and `complete` — must keep the user's cwd, since that's what
# generators resolve against (package.json scripts, Xcode schemes).
case "${1:-}" in
  init | reinit)
    cd "$(dirname "$ENTRY")/.." || exit 1
    ;;
esac

exec node "$ENTRY" "$@"
