+  /**
+   * The replacement an accept key would apply right now, or undefined if there is
+   * nothing to accept.
+   *
+   * calculateReplacement() already returns undefined when the token is fully typed
+   * (only a trailing space would be inserted), which is what makes Enter fall
+   * through and submit on an exact match instead of demanding a second press.
+   */
+  #pendingAcceptance(): ReplacementAction | undefined {
+    if (!this.#suggestBlob || this.#suggestBlob.suggestions.length == 0) return undefined;
+    const suggestion = this.#suggestBlob.suggestions.at(this.#activeSuggestionIdx);
+    if (suggestion == null) return undefined;
+    return calculateReplacement(this.#suggestBlob.activeToken, suggestion);
+  }
+
+  #isAcceptKey(name: string, shift: boolean, ctrl: boolean): boolean {
+    const config = getConfig();
+    const { key, shift: acceptShift, control: acceptCtrl } = config.bindings.acceptSuggestion;
+    if (name == key && shift == !!acceptShift && ctrl == !!acceptCtrl) return true;
+    if (shift || ctrl) return false;
+    if (config.acceptOnEnter && name == "return") return true;
+    if (config.acceptOnRightArrow && name == "right") {
+      // Only at end of line. Mid-line, right arrow must keep moving the cursor —
+      // hijacking it there would make the line uneditable.
+      return this.#term.getCommandState().cursorTerminated === true;
+    }
+    return false;
+  }
+
   update(keyPress: KeyPress, allowBindings = true): boolean {
     const { name, shift, ctrl } = keyPress;
-    if (name == "return") {
+
+    // Resolved up front because Enter is now overloaded: when it is going to accept
+    // a suggestion it must NOT clear the command, or it would wipe the very line the
+    // acceptance is about to edit.
+    const acceptance = allowBindings && this.#isAcceptKey(name, shift, ctrl) ? this.#pendingAcceptance() : undefined;
+
+    if (name == "return" && acceptance == null) {
       this.#term.clearCommand(); // clear the current command on enter
     }
 
