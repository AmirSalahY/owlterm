+// The command line is classified and coloured the way zsh-syntax-highlighting's
+// main highlighter does it, so a line looks the same inside owlterm as outside.
+// The shell integration switches the plugin itself off (ZSH_HIGHLIGHT_MAXLENGTH=0)
+// because owlterm repaints these cells and the two would fight over them.
+export type HighlightStyle =
+  | "unknown-token"
+  | "reserved-word"
+  | "precommand"
+  | "arg0"
+  | "subcommand"
+  | "path"
+  | "globbing"
+  | "history-expansion"
+  | "single-quoted-argument"
+  | "double-quoted-argument"
+  | "dollar-quoted-argument"
+  | "dollar-double-quoted-argument"
+  | "command-substitution-delimiter"
+  | "back-quoted-argument-delimiter"
+  | "redirection";
+
+// zsh-syntax-highlighting's defaults, from highlighters/main/main-highlighter.zsh.
+// Styles it leaves at `none` (options, plain arguments, assignments, separators)
+// have no entry and render in the terminal's own foreground.
+export const highlightStyles: Record<HighlightStyle, string> = {
+  "unknown-token": "fg=red,bold",
+  "reserved-word": "fg=yellow",
+  precommand: "fg=green,underline",
+  arg0: "fg=green",
+  // The plugin has no subcommand style. Bright green reads as part of the
+  // command without being mistaken for one.
+  subcommand: "fg=10",
+  path: "underline",
+  globbing: "fg=blue",
+  "history-expansion": "fg=blue",
+  "single-quoted-argument": "fg=yellow",
+  "double-quoted-argument": "fg=yellow",
+  "dollar-quoted-argument": "fg=yellow",
+  "dollar-double-quoted-argument": "fg=cyan",
+  "command-substitution-delimiter": "fg=magenta",
+  "back-quoted-argument-delimiter": "fg=magenta",
+  redirection: "fg=yellow",
+};
+
+const sgrColors: Record<string, number> = { black: 0, red: 1, green: 2, yellow: 3, blue: 4, magenta: 5, cyan: 6, white: 7 };
+const sgrAttributes: Record<string, number> = { bold: 1, underline: 4 };
+
+// zsh's fg=N: 0-7 and 8-15 are the terminal's normal and bright colours.
+const paletteIndexSgr = (index: number): number[] => (index < 8 ? [30 + index] : index < 16 ? [90 + index - 8] : [38, 5, index]);
+
+// Palette colours rather than truecolor: that is what the plugin emits, so the
+// line follows the terminal's theme exactly as it does in a plain zsh.
+export const highlightSgr = (style: HighlightStyle | undefined): string => {
+  const codes = [0];
+  for (const part of style ? highlightStyles[style].split(",") : []) {
+    const [key, value] = part.split("=");
+    if (key === "fg" && sgrColors[value] != null) codes.push(30 + sgrColors[value]);
+    else if (key === "fg" && /^\d+$/.test(value)) codes.push(...paletteIndexSgr(Number(value)));
+    else if (sgrAttributes[key] != null) codes.push(sgrAttributes[key]);
+  }
+  return `\x1b[${codes.join(";")}m`;
+};
 
