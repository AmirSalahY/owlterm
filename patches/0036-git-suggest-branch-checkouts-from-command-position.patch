diff --git a/src/runtime/gitRefs.ts b/src/runtime/gitRefs.ts
new file mode 100644
index 0000000..28117e0
--- /dev/null
+++ b/src/runtime/gitRefs.ts
@@ -0,0 +1,49 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import childProcess from "node:child_process";
+
+type RefCacheEntry = {
+  loadedAt: number;
+  refs: Set<string>;
+};
+
+const cache = new Map<string, RefCacheEntry>();
+const cacheTtlMs = 5000;
+
+const git = (cwd: string, args: string[]): string | undefined => {
+  try {
+    return childProcess.execFileSync("git", ["-C", cwd, ...args], {
+      encoding: "utf8",
+      stdio: ["ignore", "pipe", "ignore"],
+    });
+  } catch {
+    return undefined;
+  }
+};
+
+const gitRoot = (cwd: string): string | undefined => git(cwd, ["rev-parse", "--show-toplevel"])?.trim() || undefined;
+
+const loadRefs = (cwd: string, localOnly: boolean): Set<string> => {
+  const root = gitRoot(cwd);
+  if (root == null) return new Set();
+
+  const key = `${root}\u0000${localOnly ? "local" : "all"}`;
+  const cached = cache.get(key);
+  if (cached != null && Date.now() - cached.loadedAt < cacheTtlMs) return cached.refs;
+
+  const namespaces = localOnly ? ["refs/heads"] : ["refs/heads", "refs/remotes"];
+  const output = git(root, ["for-each-ref", "--format=%(refname:short)", ...namespaces]) ?? "";
+  const refs = new Set(
+    output
+      .split(/\r?\n/)
+      .map((ref) => ref.trim())
+      .filter((ref) => ref.length > 0 && !ref.endsWith("/HEAD")),
+  );
+  cache.set(key, { loadedAt: Date.now(), refs });
+  return refs;
+};
+
+export const localGitBranches = (cwd: string): string[] => [...loadRefs(cwd, true)].sort((a, b) => a.localeCompare(b));
+
+export const isGitRef = (cwd: string, token: string): boolean => loadRefs(cwd, false).has(token);
