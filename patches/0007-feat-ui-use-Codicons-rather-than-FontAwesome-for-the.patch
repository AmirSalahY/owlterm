@@ -23,7 +23,7 @@ afterEach(() => {
 
 describe("icon style resolution", () => {
   it("honours an explicit style over auto-detection", () => {
-    (["nerd", "unicode", "emoji", "none"] as const).forEach((style) => {
+    (["codicon", "unicode", "emoji", "none"] as const).forEach((style) => {
       expect(withStyle(style, resolveIconStyle)).toEqual(style);
     });
   });
@@ -37,7 +37,7 @@ describe("icon sets", () => {
   // The renderer reserves the icon column by measured width. A double-width glyph
   // in a set therefore shunts that one row's label a cell out of line — the exact
   // ragged column the emoji default was replaced to fix.
-  it.each(["nerd", "unicode"])("renders every %s icon in a single cell", (style) => {
+  it.each(["codicon", "unicode"])("renders every %s icon in a single cell", (style) => {
     withStyle(style, () => {
       ALL_KEYS.forEach((key) => {
         expect([key, wcswidth(SuggestionIcons[key])]).toEqual([key, 1]);
@@ -69,8 +69,12 @@ describe("icon sets", () => {
 });
 
 describe("spec-supplied icons", () => {
-  it("passes a literal glyph through under nerd and emoji", () => {
-    expect(withStyle("nerd", () => getIcon("🍺", "arg"))).toEqual("🍺");
+  it('treats the old "nerd" style name as an alias for codicon', () => {
+    expect(withStyle("nerd", resolveIconStyle)).toEqual("codicon");
+  });
+
+  it("passes a literal glyph through under codicon and emoji", () => {
+    expect(withStyle("codicon", () => getIcon("🍺", "arg"))).toEqual("🍺");
     expect(withStyle("emoji", () => getIcon("🍺", "arg"))).toEqual("🍺");
   });
 
@@ -80,15 +84,17 @@ describe("spec-supplied icons", () => {
     });
   });
 
-  it("resolves fig:// icon urls to nerd glyphs only under nerd", () => {
+  it("resolves fig:// icon urls to brand glyphs only under codicon", () => {
     const url = "fig://icon?type=git";
-    expect(withStyle("nerd", () => getIcon(url, "subcommand"))).toEqual("");
+    // Brand marks (git, docker, npm) have no Codicon equivalent, so these stay
+    // Devicons — still Nerd Font territory, hence gated on the same style.
+    expect(withStyle("codicon", () => getIcon(url, "subcommand"))).toEqual("");
     // Without a patched font that codepoint is tofu, so fall back to the type icon.
     expect(withStyle("unicode", () => getIcon(url, "subcommand"))).toEqual(withStyle("unicode", () => SuggestionIcons.Subcommand));
   });
 
   it("falls back to the type icon for an unmapped fig:// icon url", () => {
-    withStyle("nerd", () => {
+    withStyle("codicon", () => {
       expect(getIcon("fig://icon?type=notathing", "option")).toEqual(SuggestionIcons.Option);
     });
   });
diff --git a/src/ui/ui-doctor.ts b/src/ui/ui-doctor.ts
index c6f87f9..bd9a302 100644
--- a/src/ui/ui-doctor.ts
+++ b/src/ui/ui-doctor.ts
@@ -28,6 +28,12 @@ const renderIconStyle = (): void => {
   const sample = [SuggestionIcons.Subcommand, SuggestionIcons.Option, SuggestionIcons.File, SuggestionIcons.Folder].join(" ");
   process.stdout.write(chalk.green("✓") + ` icons: ${chalk.bold(style)} ${style === "none" ? "" : chalk.dim(`(${sample})`)}\n`);
 
+  // Both of these bypass detection entirely, so reporting on fonts would be
+  // describing a decision that wasn't made.
+  if (process.env.IS_ICONS) {
+    process.stdout.write(chalk.dim(`  forced by IS_ICONS=${process.env.IS_ICONS} for this session; unset it to fall back to theme.icons\n`));
