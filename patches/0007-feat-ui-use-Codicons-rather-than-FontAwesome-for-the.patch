From 92fda0a3d2c3ca295612d8b804104840b66e5250 Mon Sep 17 00:00:00 2001
From: AmirSalahY <hello@noury.ch>
Date: Sun, 2 Aug 2026 12:39:43 +0300
Subject: [PATCH 07/22] feat(ui): use Codicons rather than FontAwesome for the
 icon column
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Codicons are VS Code's own set — the same artwork IntelliSense uses for its
completion list, which is this exact job. Mappings follow VS Code's semantics
rather than picking shapes: symbol-parameter really is its icon for a parameter.

theme.icons gains "codicon"; "nerd" stays as a deprecated alias. The rename
reflects that the two names describe different layers — Codicons are the artwork,
a Nerd Font is the container that gets them into a terminal, since a terminal
renders characters and an icon therefore has to be one (U+EA60-EC1E, private use
area). Verified all nine codepoints resolve in MesloLGS NF.

is doctor also stops reporting on font detection when IS_ICONS forces a style,
which bypasses detection entirely.
---
 src/runtime/icons.ts            | 60 ++++++++++++++++++++-------------
 src/tests/runtime/icons.test.ts | 20 +++++++----
 src/ui/ui-doctor.ts             |  8 ++++-
 src/utils/config.ts             | 14 +++++---
 4 files changed, 66 insertions(+), 36 deletions(-)

diff --git a/src/runtime/icons.ts b/src/runtime/icons.ts
index 041b6f1..fb5eba0 100644
--- a/src/runtime/icons.ts
+++ b/src/runtime/icons.ts
@@ -13,26 +13,34 @@ type IconKey = "File" | "Folder" | "Subcommand" | "Option" | "Argument" | "Mixin
 type IconSet = Record<IconKey, string>;
 
 /**
- * Nerd Font glyphs (FontAwesome + Codicons + Devicons, private use area). Every
- * one is single-cell, so the icon column can't shove the labels sideways the way
- * the emoji set did — emoji are double-width, and the ones with a variation
- * selector (🏝️) are inconsistently measured across terminals.
+ * Codicons — VS Code's own icon set, the same artwork IntelliSense uses for its
+ * completion list, which is exactly the job here. Reached through a Nerd Font:
+ * Codicons live at U+EA60–U+EC1E in the private use area, and a patched font is
+ * the only way a terminal gets them, since a terminal renders text and nothing
+ * else.
+ *
+ * Semantics follow VS Code's own usage rather than picking pretty shapes —
+ * symbol-parameter really is its icon for a parameter.
+ *
+ * Every glyph is single-cell (enforced by a test), so the icon column can't shove
+ * labels sideways the way the emoji set did: emoji are double-width, and the ones
+ * carrying a variation selector are measured inconsistently across terminals.
  */
-const nerdIcons: IconSet = {
-  File: "", // nf-fa-file
-  Folder: "", // nf-fa-folder
-  Subcommand: "", // nf-fa-cog
-  Option: "", // nf-fa-wrench
-  Argument: "", // nf-fa-sliders
-  Mixin: "", // nf-fa-link
-  Shortcut: "", // nf-fa-bolt
-  Special: "", // nf-fa-star
-  Default: "", // nf-fa-circle
+const codiconIcons: IconSet = {
+  File: "\uea7b", // cod-file
+  Folder: "\uea83", // cod-folder
+  Subcommand: "\uea8c", // cod-symbol-method — an invocable
+  Option: "\ueb65", // cod-symbol-property — a flag on the command
+  Argument: "\uea92", // cod-symbol-parameter
+  Mixin: "\ueb15", // cod-link — a mixin pulls in another spec
+  Shortcut: "\uea86", // cod-zap
+  Special: "\ueb59", // cod-star-full
+  Default: "\uea71", // cod-circle-filled
 };
 
 /**
  * Geometric symbols that render in essentially any monospace font. The fallback
- * when no Nerd Font is installed: monochrome and single-cell like the real icon
+ * when no Nerd Font is installed: monochrome and single-cell like the Codicon
  * set, so the menu keeps its shape either way.
  */
 const unicodeIcons: IconSet = {
@@ -64,23 +72,29 @@ const emojiIcons: IconSet = {
 
 const noIcons: IconSet = { File: "", Folder: "", Subcommand: "", Option: "", Argument: "", Mixin: "", Shortcut: "", Special: "", Default: "" };
 
-const ICON_STYLES = ["nerd", "unicode", "emoji", "none"] as const;
+const ICON_STYLES = ["codicon", "unicode", "emoji", "none"] as const;
+
+/** "nerd" named the delivery mechanism; "codicon" names the artwork. */
+const normalise = (style: string | undefined): Exclude<IconStyle, "auto"> | undefined => {
+  if (style === "nerd") return "codicon";
+  return (ICON_STYLES as readonly string[]).includes(style ?? "") ? (style as Exclude<IconStyle, "auto">) : undefined;
+};
 
 export const resolveIconStyle = (): Exclude<IconStyle, "auto"> => {
   // Env override wins over the rc file: it makes the choice deterministic for
   // tests, and lets `IS_ICONS=emoji is` try a set without editing config.
-  const override = process.env.IS_ICONS as Exclude<IconStyle, "auto"> | undefined;
-  if (override && (ICON_STYLES as readonly string[]).includes(override)) return override;
+  const override = normalise(process.env.IS_ICONS);
+  if (override != null) return override;
 
   const configured = getConfig().theme.icons;
-  if (configured !== "auto") return configured;
-  return hasNerdFont() ? "nerd" : "unicode";
+  if (configured !== "auto") return normalise(configured) ?? "unicode";
+  return hasNerdFont() ? "codicon" : "unicode";
 };
 
 const activeIconSet = (): IconSet => {
   switch (resolveIconStyle()) {
-    case "nerd":
-      return nerdIcons;
+    case "codicon":
+      return codiconIcons;
     case "emoji":
       return emojiIcons;
     case "none":
@@ -146,7 +160,7 @@ export const getIcon = (icon: string | undefined, suggestionType: Fig.Suggestion
   if (icon && /[^\u0000-\u00ff]/.test(icon) && style !== "unicode") {
     return icon;
   }
-  if (icon && icon.startsWith("fig://icon?type=") && style === "nerd") {
+  if (icon && icon.startsWith("fig://icon?type=") && style === "codicon") {
     const iconType = icon.split("fig://icon?type=")[1].toLowerCase();
     const iconUtf = NerdFontIcons[iconType as keyof typeof NerdFontIcons];
     if (iconUtf != null && iconUtf !== "") {
diff --git a/src/tests/runtime/icons.test.ts b/src/tests/runtime/icons.test.ts
index 7876013..0cc8851 100644
--- a/src/tests/runtime/icons.test.ts
