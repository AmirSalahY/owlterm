+  }
   if (getConfig().theme.icons !== "auto") {
     process.stdout.write(chalk.dim(`  set explicitly via theme.icons; "auto" would pick for you\n`));
     return;
@@ -43,7 +49,7 @@ const renderIconStyle = (): void => {
   } else if (!terminalConfigured) {
     // The tofu case: font present, but this terminal isn't set to use it.
     process.stdout.write(
-      chalk.dim("  a Nerd Font is installed but this terminal isn't using it, so the plain set was chosen.\n") +
+      chalk.dim("  a Nerd Font (how a terminal receives Codicons) is installed, but this terminal\n  isn't using it, so the plain set was chosen.\n") +
         chalk.dim("  set ") +
         chalk.cyan("terminal.integrated.fontFamily") +
         chalk.dim(' to e.g. "MesloLGS NF" to get the full icon set here\n'),
diff --git a/src/utils/config.ts b/src/utils/config.ts
index edc336b..cf3a5fc 100644
--- a/src/utils/config.ts
+++ b/src/utils/config.ts
@@ -20,10 +20,14 @@ type Binding = {
 };
 
 /**
- * "auto" picks nerd when a patched font is installed and unicode otherwise, so
- * the menu never renders a column of tofu on a machine that can't draw glyphs.
+ * "auto" picks codicon when the terminal can actually render the glyphs and
+ * unicode otherwise, so the menu never renders a column of tofu.
+ *
+ * "nerd" is the former name for "codicon" — the artwork changed from FontAwesome
+ * to Codicons, but a Nerd Font is still how a terminal receives either. Accepted
+ * as an alias so existing rc files keep working.
  */
-export type IconStyle = "auto" | "nerd" | "unicode" | "emoji" | "none";
+export type IconStyle = "auto" | "codicon" | "nerd" | "unicode" | "emoji" | "none";
 
 type Theme = {
   /** Box-drawing border colour. The engine always supported this but never set it. */
@@ -165,7 +169,7 @@ const configSchema = {
         pointer: { type: "string", nullable: true },
         corners: { type: "string", nullable: true, enum: ["rounded", "square"] },
         surface: { type: "string", nullable: true },
-        icons: { type: "string", nullable: true, enum: ["auto", "nerd", "unicode", "emoji", "none"] },
+        icons: { type: "string", nullable: true, enum: ["auto", "codicon", "nerd", "unicode", "emoji", "none"] },
       },
     },
   },
@@ -257,7 +261,7 @@ export const loadConfig = async (program: Command) => {
           surface: config?.theme?.surface ?? globalConfig.theme.surface,
           // useNerdFont predates theme.icons and only ever gated fig:// icon URLs.
           // Honoured as a shorthand so existing rc files keep working.
-          icons: config?.theme?.icons ?? (config?.useNerdFont ? "nerd" : globalConfig.theme.icons),
+          icons: config?.theme?.icons ?? (config?.useNerdFont ? "codicon" : globalConfig.theme.icons),
         },
       };
     }
