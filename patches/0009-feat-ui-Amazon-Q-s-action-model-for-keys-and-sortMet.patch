diff --git a/src/tests/keys.test.ts b/src/tests/keys.test.ts
new file mode 100644
index 0000000..26f8d53
--- /dev/null
+++ b/src/tests/keys.test.ts
@@ -0,0 +1,200 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+// Lives outside src/tests/ui/ deliberately: that directory is excluded from
+// `npm test` (testPathIgnorePatterns) because its suites drive a real pty. These
+// exercise key dispatch against a stub terminal, so they run in the normal suite.
+
+import { SuggestionManager, resetSizeOverride, getMaxLines } from "../ui/suggestionManager.js";
+import { Shell } from "../utils/shell.js";
+import { Suggestion, SuggestionBlob } from "../runtime/model.js";
+
+const makeTerm = (commandText: string, cursorTerminated = true) => {
+  const written: string[] = [];
+  return {
+    written,
+    cols: 120,
+    cwd: "/tmp/project",
+    getCommandState: () => ({ commandText, cursorTerminated, hasOutput: false }),
+    write: (data: string) => written.push(data),
+    clearCommand: () => written.push("<clear>"),
+    noop: () => {},
+  };
+};
+
+const suggestion = (name: string, extra: Partial<Suggestion> = {}): Suggestion => ({
+  name,
+  allNames: [name],
+  icon: "",
+  priority: 50,
+  ...extra,
+});
+
+/**
+ * Loads a blob through the real runtime seam rather than poking at private
+ * state, so the tests break if the load path changes shape.
+ */
+const makeManager = async (term: ReturnType<typeof makeTerm>, suggestions: Suggestion[], token?: string) => {
+  const activeToken = token == null ? undefined : { token, tokenLength: token.length, complete: false, isOption: false };
+  const blob: SuggestionBlob = { suggestions, activeToken };
+  const manager = new SuggestionManager(term as never, Shell.Zsh, Promise.resolve({ getSuggestions: async () => blob }));
+  await manager.exec();
+  return manager;
+};
+
+const press = (name: string, mods: { meta?: boolean; ctrl?: boolean; shift?: boolean } = {}) => ({
+  name,
+  sequence: name,
+  ctrl: !!mods.ctrl,
+  shift: !!mods.shift,
+  meta: !!mods.meta,
+});
+
+const BACKSPACE = "";
+
+beforeEach(() => resetSizeOverride());
+
+describe("select by number", () => {
+  it("accepts the Nth visible suggestion on alt+N", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("add"), suggestion("branch"), suggestion("commit")]);
+
+    expect(m.update(press("2", { meta: true }))).toBe(true);
+    expect(term.written.join("")).toEqual("branch ");
+  });
+
+  it("ignores a number past the end of the list", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("add")]);
+
+    expect(m.update(press("5", { meta: true }))).toBe(false);
+    expect(term.written).toEqual([]);
+  });
+
+  it("leaves a bare digit alone so it stays ordinary input", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("add"), suggestion("branch")]);
+
+    expect(m.update(press("2"))).toBe(false);
+    expect(term.written).toEqual([]);
+  });
+});
+
+describe("insertCommonPrefix", () => {
+  it("inserts the shared prefix without committing the token", async () => {
+    const term = makeTerm("git c");
+    const m = await makeManager(term, [suggestion("commit"), suggestion("config")], "c");
+
+    expect(m.update(press("i", { meta: true }))).toBe(true);
+    // Replaces the typed token with the full shared prefix and stops there — no
+    // trailing space, because "co" is still ambiguous between the two.
+    expect(term.written.join("")).toEqual(BACKSPACE.repeat(1) + "co");
+  });
+
+  it("is a no-op once the typed token already is the shared prefix", async () => {
+    const term = makeTerm("git co");
+    const m = await makeManager(term, [suggestion("commit"), suggestion("config")], "co");
+
+    expect(m.update(press("i", { meta: true }))).toBe(false);
+    expect(term.written).toEqual([]);
+  });
+
+  it("extends to the full shared prefix when it is longer than what was typed", async () => {
+    const term = makeTerm("git com");
+    const m = await makeManager(term, [suggestion("commit"), suggestion("commit-tree")], "com");
+
+    expect(m.update(press("i", { meta: true }))).toBe(true);
+    expect(term.written.join("")).toEqual(BACKSPACE.repeat(3) + "commit");
+  });
+
+  it("does nothing when the candidates diverge at what was typed", async () => {
+    const term = makeTerm("git c");
+    const m = await makeManager(term, [suggestion("commit"), suggestion("branch")], "c");
+
+    expect(m.update(press("i", { meta: true }))).toBe(false);
+    expect(term.written).toEqual([]);
+  });
+
+  it("does nothing with a single candidate — that is plain acceptance", async () => {
+    const term = makeTerm("git co");
+    const m = await makeManager(term, [suggestion("commit")], "co");
+
+    expect(m.update(press("i", { meta: true }))).toBe(false);
+  });
+});
+
+describe("executeSelected", () => {
+  it("accepts and submits in one keystroke", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("status")]);
+
+    expect(m.update(press("return", { meta: true }))).toBe(true);
+    expect(term.written.join("")).toEqual("status \r");
+  });
+
+  it("falls through when there is nothing left to accept", async () => {
+    const term = makeTerm("git status");
+    // Fully typed: calculateReplacement has nothing to insert but a space.
+    const m = await makeManager(term, [suggestion("status")], "status");
+
+    expect(m.update(press("return", { meta: true }))).toBe(false);
+  });
+});
+
+describe("size", () => {
+  it("grows and shrinks the visible list", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("add")]);
+    const before = getMaxLines();
+
+    expect(m.update(press("l", { meta: true }))).toBe(true);
+    expect(getMaxLines()).toBeGreaterThan(before);
+
+    expect(m.update(press("s", { meta: true }))).toBe(true);
+    expect(getMaxLines()).toEqual(before);
+  });
+
+  it("stays swallowed at the floor rather than leaking the escape sequence", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("add")]);
+
+    for (let i = 0; i < 30; i++) m.update(press("s", { meta: true }));
+    expect(m.update(press("s", { meta: true }))).toBe(true);
+    expect(term.written).toEqual([]);
+  });
+});
+
+describe("toggleDescription", () => {
+  it("hides the description panel and keeps the menu open", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("add", { description: "Add file contents to the index" })]);
+
+    const rowWidth = (rows: { length: number }[]) => Math.max(...rows.map((r) => r.length));
+    const shown = rowWidth(m.render("below", 0));
+
+    expect(m.update(press("d", { meta: true }))).toBe(true);
+    const hidden = rowWidth(m.render("below", 0));
+    expect(hidden).toBeLessThan(shown);
+
+    // Toggles back.
+    expect(m.update(press("d", { meta: true }))).toBe(true);
+    expect(rowWidth(m.render("below", 0))).toEqual(shown);
+  });
+});
+
+describe("modifiers are not confused", () => {
+  it("does not treat ctrl+d as alt+d", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("add", { description: "desc" })]);
+
+    expect(m.update(press("d", { ctrl: true }))).toBe(false);
+  });
+
+  it("still accepts on plain tab", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("add")]);
+
+    expect(m.update(press("tab"))).toBe(true);
+    expect(term.written.join("")).toEqual("add ");
+  });
+});
diff --git a/src/tests/ordering.test.ts b/src/tests/ordering.test.ts
new file mode 100644
index 0000000..d2503e2
--- /dev/null
+++ b/src/tests/ordering.test.ts
@@ -0,0 +1,187 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import fs from "node:fs";
+import path from "node:path";
+
+import { loadFrecency, recordCommand, recordAcceptance, rankingBoost, recencyPriority } from "../utils/frecency.js";
+import { allResourcesPath } from "../utils/constants.js";
+import { getSuggestions } from "../runtime/runtime.js";
+import { unpackResources } from "../utils/node.js";
+import { getConfig } from "../utils/config.js";
+import { Shell } from "../utils/shell.js";
+
+const frecencyPath = path.join(allResourcesPath, "frecency.jsonl");
+
+// These write to the real ~/.inshellisense/frecency.jsonl, so preserve whatever
+// is there — the developer running the suite is very likely also a user.
+let saved: string | undefined;
+
+beforeAll(() => {
+  try {
+    saved = fs.readFileSync(frecencyPath, "utf-8");
+  } catch {
+    saved = undefined;
+  }
+});
+
+afterAll(() => {
+  if (saved != null) fs.writeFileSync(frecencyPath, saved);
+  else fs.rmSync(frecencyPath, { force: true });
+});
+
+beforeEach(async () => {
+  fs.rmSync(frecencyPath, { force: true });
+  await loadFrecency(true);
+});
+
+const flush = () => new Promise((r) => setTimeout(r, 20));
+
+describe("frecency ranking", () => {
+  it("gives no boost to a command never run", () => {
+    expect(rankingBoost(["git"], "rebase", "/repo")).toEqual(0);
+  });
+
+  it("boosts a command that was run", () => {
+    recordCommand("git checkout main", "/repo");
+    expect(rankingBoost(["git"], "checkout", "/repo")).toBeGreaterThan(0);
+  });
+
+  it("weights the directory it was run in above elsewhere", () => {
+    recordCommand("git checkout main", "/repo-a");
+    expect(rankingBoost(["git"], "checkout", "/repo-a")).toBeGreaterThan(rankingBoost(["git"], "checkout", "/repo-b"));
+  });
+
+  it("never exceeds the cap, however heavily used", () => {
+    for (let i = 0; i < 500; i++) recordCommand("git status", "/repo");
+    expect(rankingBoost(["git"], "status", "/repo")).toBeLessThanOrEqual(25);
+  });
+
+  it("decays with age", async () => {
+    const old = Date.now() - 60 * 86_400_000; // ~4 half-lives
+    fs.mkdirSync(allResourcesPath, { recursive: true });
+    fs.writeFileSync(
+      frecencyPath,
+      [JSON.stringify({ k: "git stale", d: "/repo", t: old, c: 8 }), JSON.stringify({ k: "git fresh", d: "/repo", t: Date.now(), c: 8 })].join("\n") + "\n",
+    );
+    await loadFrecency(true);
+
+    expect(rankingBoost(["git"], "fresh", "/repo")).toBeGreaterThan(rankingBoost(["git"], "stale", "/repo"));
+  });
+
+  it("is inert when disabled", async () => {
+    recordCommand("git status", "/repo");
+    await loadFrecency(false);
+    expect(rankingBoost(["git"], "status", "/repo")).toEqual(0);
+  });
+});
+
+describe("learning from acceptance", () => {
+  it("boosts a suggestion that was accepted but never executed", () => {
+    expect(rankingBoost(["git"], "cherry-pick", "/repo")).toEqual(0);
+    recordAcceptance(["git"], "cherry-pick", "/repo");
+    expect(rankingBoost(["git"], "cherry-pick", "/repo")).toBeGreaterThan(0);
+  });
+
+  it("counts an acceptance for less than an execution", () => {
+    recordAcceptance(["git"], "accepted", "/repo");
+    recordCommand("git executed", "/repo");
+    expect(rankingBoost(["git"], "executed", "/repo")).toBeGreaterThan(rankingBoost(["git"], "accepted", "/repo"));
+  });
+
+  it("persists across a reload", async () => {
+    recordAcceptance(["git"], "bisect", "/repo");
+    await flush();
+    await loadFrecency(true);
+    expect(rankingBoost(["git"], "bisect", "/repo")).toBeGreaterThan(0);
+  });
+
+  it("ignores an empty candidate", () => {
+    recordAcceptance(["git"], "", "/repo");
+    expect(rankingBoost(["git"], "", "/repo")).toEqual(0);
+  });
+});
+
+describe("ranking through the real suggestion pipeline", () => {
+  // Regression guard. rankSuggestions used to build its key from acceptedTokens,
+  // which the recursion seeds as [] — so it looked up "rebase" while
+  // recordCommand had stored "git rebase", and the boost was dead for every
+  // subcommand. Testing rankingBoost alone did not catch it; only going through
+  // getSuggestions does.
+  beforeAll(async () => await unpackResources());
+
+  const names = async (cmd: string) => ((await getSuggestions(cmd, process.cwd(), Shell.Bash))?.suggestions ?? []).map((s) => s.name);
+
+  it("lifts a subcommand that was run, at the first level", async () => {
+    getConfig().sortMethod = "frecency";
+    const before = await names("git ");
+    expect(before[0]).not.toEqual("rebase");
+
+    recordCommand("git rebase --continue", process.cwd());
+    expect((await names("git "))[0]).toEqual("rebase");
+  });
+
+  it("lifts an option that was run, at a deeper level", async () => {
+    getConfig().sortMethod = "frecency";
+    recordCommand("git rebase --continue", process.cwd());
+    const after = await names("git rebase ");
+    expect(after.indexOf("--continue")).toBeGreaterThanOrEqual(0);
+    expect(after.indexOf("--continue")).toBeLessThan(after.indexOf("--onto"));
+  });
+
+  it("leaves order untouched under sortMethod = none", async () => {
+    recordCommand("git rebase --continue", process.cwd());
+    getConfig().sortMethod = "none";
+    expect((await names("git "))[0]).not.toEqual("rebase");
+  });
+
+  it("sorts by name under sortMethod = alphabetical", async () => {
+    recordCommand("git rebase --continue", process.cwd());
+    getConfig().sortMethod = "alphabetical";
+    const result = await names("git ");
+    expect(result).toEqual([...result].sort((a, b) => a.localeCompare(b)));
+  });
+
+  afterAll(() => {
+    getConfig().sortMethod = "frecency";
+  });
+});
+
+describe("recency ordering (Amazon Q's model)", () => {
+  it("leaves an unused suggestion at its spec priority", () => {
+    expect(recencyPriority(["git"], "rebase", "/repo", 50)).toEqual(50);
+  });
+
+  it("promotes anything used to 75, per Q's updatePriorities", () => {
+    recordCommand("git checkout main", "/repo");
+    expect(recencyPriority(["git"], "checkout", "/repo", 50)).toBeGreaterThanOrEqual(75);
