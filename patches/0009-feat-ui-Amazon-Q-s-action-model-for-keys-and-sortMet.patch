+            removeAcceptedSuggestions(adjustPathSuggestions(rankSuggestions(suggestions, allTokens, cwd), partialToken, lastToken, shell), acceptedTokens),
             allTokens,
           ),
           partialToken,
@@ -356,7 +382,7 @@ export const getArgDrivenRecommendation = async (
