--- a/src/runtime/suggestion.ts
+++ b/src/runtime/suggestion.ts
@@ -12,7 +12,7 @@ import log from "../utils/log.js";
 import { escapePath } from "./utils.js";
 import { addPathSeparator, endsWithPathSeparator, getPathDirname, removePathSeparator, Shell } from "../utils/shell.js";
 import { getConfig } from "../utils/config.js";
-import { rankingBoost } from "../utils/frecency.js";
+import { rankingBoost, recencyPriority } from "../utils/frecency.js";
 // Re-exported for the many call sites (and tests) that reach for icons via this module.
 export { SuggestionIcons, NerdFontIcons, getIcon, resolveIconStyle } from "./icons.js";
 import { getIcon } from "./icons.js";
@@ -229,10 +229,36 @@ function adjustPathSuggestions(
  * The frecency boost is additive on top of the spec's own priority, so
  * spec-declared intent still sets the baseline order.
  */
-const rankSuggestions = (suggestions: Suggestion[], acceptedTokens: CommandToken[], cwd: string): Suggestion[] => {
-  const prefix = acceptedTokens.map((t) => t.token);
+const rankSuggestions = (suggestions: Suggestion[], allTokens: CommandToken[], cwd: string): Suggestion[] => {
+  // Derived from allTokens, NOT acceptedTokens: the recursion is seeded with
+  // activeCmd.slice(1) and acceptedTokens defaulted to [], so the command name is
+  // absent from it at every depth. Ranking off that produced the key "rebase"
+  // while recordCommand had stored "git rebase" — they never matched, and the
+  // boost was silently dead for every subcommand.
+  //
+  // Complete tokens only, so the partial word being typed isn't treated as part
+  // of the prefix it is trying to complete.
+  const prefix = allTokens.filter((t) => t.complete).map((t) => t.token);
+  const method = getConfig().sortMethod;
+
+  if (method === "alphabetical") {
+    // Purely by name — priority deliberately ignored too. Keeping it as the
+    // primary key would band options (45) below subcommands (50), so the list
+    // would not actually read A-Z, which is the one thing this mode promises.
+    return [...suggestions].sort((a, b) => a.name.localeCompare(b.name));
+  }
+
+  const score =
+    method === "none"
+      ? (s: Suggestion) => s.priority
+      : method === "recency"
+      ? (s: Suggestion) => recencyPriority(prefix, s.name, cwd, s.priority)
+      : // Additive on top of the spec's own priority, so spec-declared intent
+        // still sets the baseline order.
+        (s: Suggestion) => s.priority + rankingBoost(prefix, s.name, cwd);
+
   return suggestions
-    .map((s) => ({ suggestion: s, score: s.priority + rankingBoost(prefix, s.name, cwd) }))
+    .map((s) => ({ suggestion: s, score: score(s) }))
     .sort((a, b) => b.score - a.score)
     .map((entry) => entry.suggestion);
 };
