 process.env.IS_ICONS ??= "unicode";
 
+// Runtime data (frecency history, unpacked specs) goes to a scratch directory,
+// never the developer's own ~/.inshellisense. Frecency writes are fire-and-forget,
+// so a save-and-restore around each test still loses the race: an append can land
+// after the restore. Set here because constants.ts reads it at import time.
+const path = require("node:path");
+process.env.ISTERM_RESOURCES_DIR ??= path.join(__dirname, ".test-resources");
