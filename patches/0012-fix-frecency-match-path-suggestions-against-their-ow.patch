 beforeEach(async () => {
   fs.rmSync(frecencyPath, { force: true });
   await loadFrecency(true);
@@ -175,6 +160,34 @@ describe("lastUsed ordering", () => {
   });
 });
 
+describe("path suggestions carry a trailing separator", () => {
+  // Regression guard. Folder suggestions reach the ranker as "src/" — the
+  // separator is only stripped afterwards, by adjustPathSuggestions — while
+  // history records what was typed, "cd src". Without normalising the two never
+  // matched, so usage ranking was dead for every path suggestion even though the
+  // history was there. Directly reported as "it's not showing the last used first".
+  it("matches history recorded without the separator", () => {
+    recordCommand("cd project", "/repo");
+    expect(lastUsedAt(["cd"], "project/", "/repo")).toBeGreaterThan(0);
+    expect(lastUsedAt(["cd"], "project/", "/repo")).toEqual(lastUsedAt(["cd"], "project", "/repo"));
+  });
+
+  it("records a typed separator under the same key", () => {
+    recordCommand("cd project/", "/repo");
+    expect(lastUsedAt(["cd"], "project", "/repo")).toBeGreaterThan(0);
+  });
+
+  it("boosts a path suggestion under frecency too", () => {
+    recordCommand("cd project", "/repo");
+    expect(rankingBoost(["cd"], "project/", "/repo")).toBeGreaterThan(0);
+  });
+
+  it("leaves a bare separator alone rather than emptying the key", () => {
+    recordCommand("cd /", "/repo");
+    expect(lastUsedAt(["cd"], "/", "/repo")).toBeGreaterThan(0);
+  });
+});
+
 describe("recency ordering (Amazon Q's model)", () => {
   it("leaves an unused suggestion at its spec priority", () => {
     expect(recencyPriority(["git"], "rebase", "/repo", 50)).toEqual(50);
diff --git a/src/utils/constants.ts b/src/utils/constants.ts
index b72369f..2b0e9ef 100644
--- a/src/utils/constants.ts
+++ b/src/utils/constants.ts
@@ -5,10 +5,24 @@ import path from "node:path";
 import os from "node:os";
 
 const inshellisenseFolderName = ".inshellisense";
-export const allResourcesPath = path.join(os.homedir(), inshellisenseFolderName);
-export const loggingResourcesPath = path.join(os.homedir(), inshellisenseFolderName, "log");
-export const nativeResourcesPath = path.join(os.homedir(), inshellisenseFolderName, "native");
-export const shellResourcesPath = path.join(os.homedir(), inshellisenseFolderName, "shell");
-export const specResourcesPath = path.join(os.homedir(), inshellisenseFolderName, "spec");
-export const initResourcesPath = path.join(os.homedir(), inshellisenseFolderName, "init");
-export const versionResourcePath = path.join(os.homedir(), inshellisenseFolderName, "version.txt");
+
+/**
+ * Root for all runtime data. Overridable so tests can be given a scratch
+ * directory.
+ *
+ * os.homedir() reads the real environment through libuv, which jest's
+ * process.env copy cannot influence — so without an explicit hook, any test
+ * touching frecency history writes to the developer's own
+ * ~/.inshellisense/frecency.jsonl. Save-and-restore is not good enough either:
+ * frecency writes are fire-and-forget, so an append can land after the restore
+ * and leave real history polluted, or lost if the run is interrupted.
+ */
+const resourcesRoot = process.env.ISTERM_RESOURCES_DIR || path.join(os.homedir(), inshellisenseFolderName);
+
+export const allResourcesPath = resourcesRoot;
+export const loggingResourcesPath = path.join(resourcesRoot, "log");
+export const nativeResourcesPath = path.join(resourcesRoot, "native");
+export const shellResourcesPath = path.join(resourcesRoot, "shell");
+export const specResourcesPath = path.join(resourcesRoot, "spec");
+export const initResourcesPath = path.join(resourcesRoot, "init");
+export const versionResourcePath = path.join(resourcesRoot, "version.txt");
