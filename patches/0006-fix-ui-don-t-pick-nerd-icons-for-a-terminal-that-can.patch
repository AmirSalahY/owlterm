+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+import { isNerdFontName, parseVscodeFontSetting, scanForNerdFont } from "../../utils/nerdfont.js";
+
+// Directories are passed in rather than derived from $HOME: jest's process.env is
+// a JS-side copy, so os.homedir() — which reads the real environment through
+// libuv — ignores any override a test sets.
+const fixture = (build: (dir: string) => void): string => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "nf-"));
+  build(dir);
+  return dir;
+};
+
+const cleanup: string[] = [];
+const tempTree = (build: (dir: string) => void): string => {
+  const dir = fixture(build);
+  cleanup.push(dir);
+  return dir;
+};
+
+afterAll(() => cleanup.forEach((dir) => fs.rmSync(dir, { recursive: true, force: true })));
+
+const writeFont = (dir: string, name: string) => {
+  fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(path.join(dir, name), "");
+};
+
+describe("nerd font naming", () => {
+  it.each([
+    "MesloLGS NF Regular.ttf",
+    "JetBrainsMonoNerdFont-Regular.ttf",
+    "Hack Nerd Font Mono.ttf",
+    "FiraCode Nerd Font",
+    // The configured family name, not a filename — the vscode path matches on this.
+    "MesloLGS NF",
+  ])("recognises %s", (name) => {
+    expect(isNerdFontName(name)).toBe(true);
+  });
+
+  it.each(["JetBrainsMono-Regular.ttf", "Menlo", "Monaco", "SF Mono", "Consolas"])("rejects %s", (name) => {
+    expect(isNerdFontName(name)).toBe(false);
+  });
+
+  it("rejects an unset font", () => {
+    expect(isNerdFontName(undefined)).toBe(false);
+  });
+});
+
+describe("font directory scan", () => {
+  it("finds a patched font", () => {
+    const dir = tempTree((d) => writeFont(d, "MesloLGS NF Regular.ttf"));
+    expect(scanForNerdFont([dir])).toBe(true);
+  });
+
+  it("reports none when only unpatched fonts are present", () => {
+    const dir = tempTree((d) => writeFont(d, "JetBrainsMono-Regular.ttf"));
+    expect(scanForNerdFont([dir])).toBe(false);
+  });
+
+  it("descends into nested font trees", () => {
+    // Linux system fonts sit under e.g. /usr/share/fonts/truetype/<family>/.
+    const dir = tempTree((d) => writeFont(path.join(d, "truetype", "hack"), "Hack Nerd Font.ttf"));
+    expect(scanForNerdFont([dir])).toBe(true);
+  });
+
+  it("survives directories that don't exist or can't be read", () => {
+    expect(scanForNerdFont(["/nope/not/here"])).toBe(false);
+  });
+});
+
+describe("vscode font setting", () => {
+  // The bug this guards: a font installed and selected in iTerm, while the
+  // editor's integrated terminal had none configured and silently fell back to
+  // Menlo — which renders every icon as tofu.
+  it("returns nothing when no font is configured", () => {
+    expect(parseVscodeFontSetting(`{ "editor.formatOnSave": true }`)).toBeUndefined();
+  });
+
+  it("reads the terminal font", () => {
+    expect(parseVscodeFontSetting(`{ "terminal.integrated.fontFamily": "MesloLGS NF" }`)).toEqual("MesloLGS NF");
+  });
+
+  it("prefers the terminal font over the editor font", () => {
+    const settings = `{\n  "editor.fontFamily": "Menlo",\n  "terminal.integrated.fontFamily": "MesloLGS NF"\n}`;
+    expect(parseVscodeFontSetting(settings)).toEqual("MesloLGS NF");
+  });
+
+  it("falls back to editor.fontFamily, which the terminal inherits", () => {
+    expect(parseVscodeFontSetting(`{ "editor.fontFamily": "Hack Nerd Font" }`)).toEqual("Hack Nerd Font");
+  });
+
+  it("ignores a commented-out setting", () => {
+    // settings.json routinely carries commented-out keys; reading one as live
+    // would claim a font the terminal isn't actually using.
+    const settings = `{\n  // "terminal.integrated.fontFamily": "MesloLGS NF",\n  "editor.tabSize": 4,\n}`;
+    expect(parseVscodeFontSetting(settings)).toBeUndefined();
+  });
+
+  it("tolerates the trailing commas that make settings.json invalid JSON", () => {
+    const settings = `{\n  "terminal.integrated.fontFamily": "MesloLGS NF",\n  "editor.tabSize": 4,\n}`;
+    expect(parseVscodeFontSetting(settings)).toEqual("MesloLGS NF");
+  });
+
+  it("handles a font stack, matching on the whole declaration", () => {
+    const settings = `{ "terminal.integrated.fontFamily": "MesloLGS NF, Menlo, monospace" }`;
+    expect(isNerdFontName(parseVscodeFontSetting(settings))).toBe(true);
+  });
+});
