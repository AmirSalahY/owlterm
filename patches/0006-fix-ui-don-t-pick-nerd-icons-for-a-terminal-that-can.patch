 // "JetBrainsMonoNerdFont-Regular.ttf", "Hack Nerd Font Mono.ttf", "MesloLGS NF.ttf"
 const NERD_FONT_FILE = /nerd[ _-]?font|\bNF\b|NerdFont/i;
 
+/** Matches both font *files* and configured font *family* names ("MesloLGS NF"). */
+export const isNerdFontName = (name: string | undefined): boolean => name != null && NERD_FONT_FILE.test(name);
+
 const scan = (dir: string, depth: number): boolean => {
   let entries: fs.Dirent[];
   try {
@@ -50,16 +50,85 @@ const scan = (dir: string, depth: number): boolean => {
   return false;
 };
 
+/**
+ * Which editor wrote the settings file backing an integrated terminal. VS Code
+ * and every fork of it sets TERM_PROGRAM=vscode without saying *which* fork, so
+ * the only way to find the right settings.json is to try the known locations.
+ */
+const VSCODE_APP_DIRS = ["Cursor", "Code", "Code - Insiders", "VSCodium", "Windsurf"];
+
+const vscodeSettingsPaths = (): string[] => {
+  const home = os.homedir();
+  const base =
+    process.platform === "darwin"
+      ? path.join(home, "Library", "Application Support")
+      : process.platform === "win32"
+      ? process.env.APPDATA ?? path.join(home, "AppData", "Roaming")
+      : path.join(home, ".config");
+  return VSCODE_APP_DIRS.map((app) => path.join(base, app, "User", "settings.json"));
+};
+
+/**
+ * settings.json is JSONC — comments and trailing commas — so JSON.parse chokes on
+ * it. A regex for the one key we care about is both simpler and far more tolerant
+ * than shipping a JSONC parser for a font-name lookup. Commented-out lines are
+ * dropped first so a `// "…fontFamily": "…"` note doesn't read as the real value.
+ */
+export const parseVscodeFontSetting = (contents: string): string | undefined => {
+  const live = contents
+    .split("\n")
+    .filter((line) => !line.trimStart().startsWith("//"))
+    .join("\n");
+  // terminal.integrated.fontFamily wins; editor.fontFamily is the documented
+  // fallback the terminal inherits when the terminal-specific key is unset.
+  const terminal = /"terminal\.integrated\.fontFamily"\s*:\s*"([^"]*)"/.exec(live);
+  const editor = /"editor\.fontFamily"\s*:\s*"([^"]*)"/.exec(live);
+  return (terminal ?? editor)?.[1];
+};
+
+const readVscodeTerminalFont = (file: string): string | undefined => {
+  try {
+    return parseVscodeFontSetting(fs.readFileSync(file, "utf8"));
+  } catch {
+    return undefined;
+  }
+};
+
+/**
+ * A font being *installed* doesn't mean the terminal is *using* it — the case
+ * that motivated this: a machine with MesloLGS NF installed and selected in
+ * iTerm still drew tofu in the VS Code terminal, which had no font configured
+ * and so fell back to Menlo.
+ *
+ * Only decided for editors whose config we can actually read. Every other
+ * terminal returns true rather than guessing: silently dropping to the plain set
+ * on a correctly-configured terminal is the worse failure, since the user gets
+ * no signal that anything was decided for them.
+ */
+const terminalUsesNerdFont = (): boolean => {
+  if (process.env.TERM_PROGRAM !== "vscode") return true;
+  return isNerdFontName(vscodeSettingsPaths().map(readVscodeTerminalFont).find(Boolean));
+};
+
+/** Exposed so tests can drive the scan against a fixture tree. */
+export const scanForNerdFont = (dirs: string[]): boolean => dirs.some((dir) => scan(dir, 2));
+
 let cached: boolean | undefined;
 
-/** Cached for the process: fonts don't get installed mid-session. */
+/** Cached for the process: neither fonts nor terminal settings change mid-session. */
 export const hasNerdFont = (): boolean => {
   if (cached != null) return cached;
-  cached = FONT_DIRS().some((dir) => scan(dir, 2));
+  cached = scanForNerdFont(FONT_DIRS()) && terminalUsesNerdFont();
   return cached;
 };
 
-/** Test seam — also lets `is doctor` report both branches. */
+/** Test seam — also lets `is doctor` report each branch separately. */
 export const resetNerdFontCache = (value?: boolean): void => {
   cached = value;
 };
+
+/** Split out so the doctor can say *which* of the two conditions failed. */
+export const nerdFontDiagnostics = (): { installed: boolean; terminalConfigured: boolean } => ({
+  installed: scanForNerdFont(FONT_DIRS()),
+  terminalConfigured: terminalUsesNerdFont(),
+});
