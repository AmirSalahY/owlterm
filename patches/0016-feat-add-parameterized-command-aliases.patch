+++ b/src/utils/managedAliases.ts
@@ -0,0 +1,181 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import childProcess from "node:child_process";
+import fsAsync from "node:fs/promises";
+import path from "node:path";
+import readline from "node:readline/promises";
+import { stdin as input, stdout as output } from "node:process";
+
+import { allResourcesPath, launcherName } from "./constants.js";
+import { Shell } from "./shell.js";
+
+export type ManagedAliasParameter = {
+  name: string;
+  tokenIndex: number;
+  defaultValue: string;
+};
+
+export type ManagedAlias = {
+  name: string;
+  tokens: string[];
+  parameters: ManagedAliasParameter[];
+  createdAt: number;
+  updatedAt: number;
+};
+
+type Store = {
+  version: 1;
+  aliases: ManagedAlias[];
+};
+
+const storePath = path.join(allResourcesPath, "managed-aliases.json");
+const frecencyPath = path.join(allResourcesPath, "frecency.jsonl");
+
+const aliasNameRegex = /^[A-Za-z0-9._:-]+$/;
+const parameterNameRegex = /^[A-Za-z][A-Za-z0-9_-]*$/;
+
+const emptyStore = (): Store => ({ version: 1, aliases: [] });
+
+export const validateAliasName = (name: string): string | undefined => {
+  if (name.length === 0) return "alias name cannot be empty";
+  if (!aliasNameRegex.test(name)) return "alias names may only contain letters, numbers, dot, underscore, colon, and hyphen";
+  return undefined;
+};
+
+export const validateParameterName = (name: string): string | undefined => {
+  if (name.length === 0) return "parameter name cannot be empty";
+  if (!parameterNameRegex.test(name)) return "parameter names must start with a letter and contain only letters, numbers, underscore, and hyphen";
+  return undefined;
+};
+
+export const shellQuote = (value: string): string => {
+  if (/^[A-Za-z0-9_/:=.,@%+-]+$/.test(value)) return value;
+  return `'${value.replaceAll("'", "'\\''")}'`;
+};
+
+export const formatCommand = (tokens: string[]): string => tokens.map(shellQuote).join(" ");
+
+export const readManagedAliases = async (): Promise<ManagedAlias[]> => {
+  try {
+    const raw = await fsAsync.readFile(storePath, "utf-8");
+    const parsed = JSON.parse(raw);
+    if (parsed?.version !== 1 || !Array.isArray(parsed.aliases)) return [];
+    return parsed.aliases.filter((alias: Partial<ManagedAlias>) => typeof alias.name === "string" && Array.isArray(alias.tokens));
+  } catch {
+    return [];
+  }
+};
+
+export const writeManagedAlias = async (alias: Omit<ManagedAlias, "createdAt" | "updatedAt">): Promise<ManagedAlias> => {
+  const aliases = await readManagedAliases();
+  const now = Date.now();
+  const existing = aliases.find((candidate) => candidate.name === alias.name);
+  const saved: ManagedAlias = {
+    ...alias,
+    createdAt: existing?.createdAt ?? now,
+    updatedAt: now,
+  };
+  const next = [saved, ...aliases.filter((candidate) => candidate.name !== alias.name)].sort((a, b) => a.name.localeCompare(b.name));
+  await fsAsync.mkdir(allResourcesPath, { recursive: true });
+  await fsAsync.writeFile(storePath, JSON.stringify({ ...emptyStore(), aliases: next }, null, 2) + "\n");
+  return saved;
+};
+
+export const removeManagedAlias = async (name: string): Promise<boolean> => {
+  const aliases = await readManagedAliases();
+  const next = aliases.filter((alias) => alias.name !== name);
+  if (next.length === aliases.length) return false;
+  await fsAsync.mkdir(allResourcesPath, { recursive: true });
+  await fsAsync.writeFile(storePath, JSON.stringify({ ...emptyStore(), aliases: next }, null, 2) + "\n");
+  return true;
+};
+
+export const getManagedAlias = async (name: string): Promise<ManagedAlias | undefined> => {
+  const aliases = await readManagedAliases();
+  return aliases.find((alias) => alias.name === name);
+};
+
+export const recentCommands = async (limit = 20): Promise<string[]> => {
+  let raw: string;
+  try {
+    raw = await fsAsync.readFile(frecencyPath, "utf-8");
+  } catch {
+    return [];
+  }
+
+  const seen = new Map<string, number>();
+  for (const line of raw.split("\n")) {
+    if (!line) continue;
+    try {
+      const parsed = JSON.parse(line);
+      if (typeof parsed.k !== "string" || typeof parsed.t !== "number") continue;
+      if (parsed.k.split(/\s+/).length < 2) continue;
+      seen.set(parsed.k, Math.max(seen.get(parsed.k) ?? 0, parsed.t));
+    } catch {
+      continue;
+    }
+  }
+
+  return [...seen.entries()]
+    .sort((a, b) => b[1] - a[1] || b[0].length - a[0].length)
+    .map(([command]) => command)
+    .slice(0, limit);
+};
+
+export const renderManagedAliasInit = async (shell: Shell): Promise<string> => {
+  if (shell !== Shell.Bash && shell !== Shell.Zsh) {
+    throw new Error(`managed aliases are only supported for bash and zsh`);
+  }
+
+  const aliases = await readManagedAliases();
+  const lines = [
+    "# termauto managed aliases",
+    "# Generated by `termauto alias init`; edit with `termauto alias set/remove`.",
+  ];
+  for (const alias of aliases) {
+    lines.push(`${alias.name}() {`);
+    lines.push(`  command ${shellQuote(launcherName())} alias run ${shellQuote(alias.name)} "$@"`);
+    lines.push("}");
+  }
+  return lines.join("\n") + "\n";
+};
+
+export const executeManagedAlias = async (alias: ManagedAlias, parameterValues: string[], printOnly: boolean): Promise<number> => {
+  if (alias.tokens.length === 0) throw new Error(`alias '${alias.name}' has no command tokens`);
+
+  const values = new Map<number, string>();
+  let nextArg = 0;
+  let rl: readline.Interface | undefined;
+  try {
+    for (const parameter of alias.parameters) {
+      let value = parameterValues[nextArg++];
+      if (value == null) {
+        rl ??= readline.createInterface({ input, output });
+        const answer = await rl.question(`${parameter.name} [${parameter.defaultValue}]: `);
+        value = answer.length > 0 ? answer : parameter.defaultValue;
+      }
+      values.set(parameter.tokenIndex, value);
+    }
+  } finally {
+    rl?.close();
+  }
+
+  const tokens = alias.tokens.map((token, index) => values.get(index) ?? token);
+  if (printOnly) {
+    process.stdout.write(formatCommand(tokens) + "\n");
+    return 0;
+  }
+
+  const child = childProcess.spawn(tokens[0], tokens.slice(1), { stdio: "inherit" });
+  return await new Promise((resolve) => {
+    child.on("error", (error) => {
+      process.stderr.write(`termauto alias: ${error.message}\n`);
+      resolve(127);
+    });
+    child.on("exit", (code, signal) => {
+      if (signal) resolve(128);
+      else resolve(code ?? 1);
+    });
+  });
+};
