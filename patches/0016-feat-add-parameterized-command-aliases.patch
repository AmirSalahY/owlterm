+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import { Command } from "commander";
+import readline from "node:readline/promises";
+import { stdin as input, stdout as output } from "node:process";
+
+import { parseCommand } from "../runtime/parser.js";
+import { inferShell, Shell } from "../utils/shell.js";
+import { launcherName } from "../utils/constants.js";
+import {
+  executeManagedAlias,
+  formatCommand,
+  getManagedAlias,
+  readManagedAliases,
+  recentCommands,
+  removeManagedAlias,
+  renderManagedAliasInit,
+  validateAliasName,
+  validateParameterName,
+  writeManagedAlias,
+  type ManagedAliasParameter,
+} from "../utils/managedAliases.js";
+
+type SetOptions = {
+  param?: string[];
+};
+
+type RunOptions = {
+  print?: boolean;
+};
+
+const parseIndexes = (raw: string, max: number): number[] => {
+  const indexes = new Set<number>();
+  for (const part of raw.split(/[,\s]+/).filter(Boolean)) {
+    const value = Number(part);
+    if (!Number.isInteger(value) || value < 1 || value > max) {
+      throw new Error(`invalid token number '${part}'`);
+    }
+    indexes.add(value - 1);
+  }
+  return [...indexes].sort((a, b) => a - b);
+};
+
+const parseParamOptions = (params: string[] | undefined, tokens: string[]): ManagedAliasParameter[] => {
+  if (!params || params.length === 0) return [];
+  return params.map((param) => {
+    const [rawIndex, name] = param.split("=");
+    const tokenIndex = Number(rawIndex) - 1;
+    if (!Number.isInteger(tokenIndex) || tokenIndex < 0 || tokenIndex >= tokens.length) {
+      throw new Error(`invalid --param token number '${rawIndex}'`);
+    }
+    const error = validateParameterName(name ?? "");
+    if (error) throw new Error(error);
+    return { name, tokenIndex, defaultValue: tokens[tokenIndex] };
+  });
+};
+
+const chooseRecentCommand = async (rl: readline.Interface): Promise<string[]> => {
+  const commands = await recentCommands();
+  if (commands.length === 0) throw new Error("no recent commands found; pass the command after -- instead");
+
+  process.stdout.write("Recent commands:\n");
+  commands.forEach((command, index) => process.stdout.write(`  ${index + 1}. ${command}\n`));
+  const raw = await rl.question("Command number: ");
+  const choice = Number(raw);
+  if (!Number.isInteger(choice) || choice < 1 || choice > commands.length) throw new Error(`invalid command number '${raw}'`);
+
+  return parseCommand(commands[choice - 1] + " ", Shell.Bash).map((token) => token.token);
+};
+
+const promptParameters = async (rl: readline.Interface, tokens: string[]): Promise<ManagedAliasParameter[]> => {
+  process.stdout.write("Command tokens:\n");
+  tokens.forEach((token, index) => process.stdout.write(`  ${index + 1}. ${token}\n`));
+
+  const selected = await rl.question("Parameter token numbers (comma-separated, blank for none): ");
+  const indexes = selected.trim().length === 0 ? [] : parseIndexes(selected, tokens.length);
+  const parameters: ManagedAliasParameter[] = [];
+  const usedNames = new Set<string>();
+
+  for (const tokenIndex of indexes) {
+    const name = await rl.question(`Name for token ${tokenIndex + 1} (${tokens[tokenIndex]}): `);
+    const error = validateParameterName(name);
+    if (error) throw new Error(error);
+    if (usedNames.has(name)) throw new Error(`duplicate parameter name '${name}'`);
+    usedNames.add(name);
+    parameters.push({ name, tokenIndex, defaultValue: tokens[tokenIndex] });
+  }
+  return parameters;
+};
+
+const setAction = (program: Command) => async (name: string, commandParts: string[], options: SetOptions) => {
+  const aliasError = validateAliasName(name);
+  if (aliasError) program.error(aliasError, { exitCode: 1 });
+
+  const rl = readline.createInterface({ input, output });
+  try {
+    const tokens = commandParts.length > 0 ? commandParts : await chooseRecentCommand(rl);
+    if (tokens.length === 0) throw new Error("alias command cannot be empty");
+    const parameters = options.param?.length ? parseParamOptions(options.param, tokens) : await promptParameters(rl, tokens);
+    const saved = await writeManagedAlias({ name, tokens, parameters });
+    process.stdout.write(`Saved ${saved.name}: ${formatCommand(saved.tokens)}\n`);
+    if (saved.parameters.length > 0) {
+      process.stdout.write(`Parameters: ${saved.parameters.map((parameter) => parameter.name).join(", ")}\n`);
+    }
+    process.stdout.write(`Enable it in bash/zsh with: eval "$(${launcherName()} alias init)"\n`);
+  } catch (error) {
+    program.error(error instanceof Error ? error.message : String(error), { exitCode: 1 });
+  } finally {
+    rl.close();
+  }
+};
+
+const runAction = (program: Command) => async (name: string, values: string[], options: RunOptions) => {
+  const alias = await getManagedAlias(name);
+  if (!alias) program.error(`unknown managed alias '${name}'`, { exitCode: 1 });
+  try {
+    const code = await executeManagedAlias(alias, values, options.print ?? false);
+    process.exit(code);
+  } catch (error) {
+    program.error(error instanceof Error ? error.message : String(error), { exitCode: 1 });
+  }
+};
+
+const listAction = async () => {
+  const aliases = await readManagedAliases();
+  for (const alias of aliases) {
+    const params = alias.parameters.length > 0 ? ` (${alias.parameters.map((parameter) => parameter.name).join(", ")})` : "";
+    process.stdout.write(`${alias.name}${params}: ${formatCommand(alias.tokens)}\n`);
+  }
+};
+
+const removeAction = (program: Command) => async (name: string) => {
+  const removed = await removeManagedAlias(name);
+  if (!removed) program.error(`unknown managed alias '${name}'`, { exitCode: 1 });
+  process.stdout.write(`Removed ${name}\n`);
+};
+
+const initAction = (program: Command) => async (shellName: string | undefined) => {
+  const shell = (shellName as Shell | undefined) ?? (await inferShell());
+  if (shell == null) program.error("Unable to identify shell, pass bash or zsh", { exitCode: 1 });
+  if (shell !== Shell.Bash && shell !== Shell.Zsh) program.error("managed aliases are only supported for bash and zsh", { exitCode: 1 });
+
+  try {
+    process.stdout.write(await renderManagedAliasInit(shell));
+  } catch (error) {
+    program.error(error instanceof Error ? error.message : String(error), { exitCode: 1 });
+  }
+};
+
+const cmd = new Command("alias");
+cmd.description("manage parameterized command aliases");
+
+const set = new Command("set");
+set.description("save a parameterized alias from a command or recent command");
+set.argument("<name>");
+set.argument("[command...]", "command tokens; use -- before commands with flags");
+set.option("-p, --param <token=name...>", "mark a token number as a parameter without prompting");
+set.allowUnknownOption(true);
+set.action(setAction(set));
+
+const run = new Command("run");
+run.description("run a managed alias, prompting for missing parameter values");
+run.argument("<name>");
+run.argument("[values...]");
+run.option("--print", "print the expanded command instead of running it");
+run.action(runAction(run));
+
+const list = new Command("list");
+list.description("list managed aliases");
+list.action(listAction);
+
+const remove = new Command("remove");
+remove.alias("rm");
+remove.description("remove a managed alias");
+remove.argument("<name>");
+remove.action(removeAction(remove));
+
+const init = new Command("init");
+init.description("print bash/zsh functions for all managed aliases");
+init.argument("[shell]", "bash or zsh");
+init.action(initAction(init));
+
+cmd.addCommand(set);
+cmd.addCommand(run);
+cmd.addCommand(list);
+cmd.addCommand(remove);
+cmd.addCommand(init);
+
+export default cmd;
