   switch (shell) {
     case Shell.Bash:
       return readBashDefinitions();
@@ -139,6 +149,9 @@ const readShellDefinitions = async (shell: Shell): Promise<ShellDefinitions> =>
 
 export const loadAliases = async (shell: Shell) => {
   const { aliases, functions } = await readShellDefinitions(shell);
+  // Rebuilt rather than merged, so an `unalias` or a deleted line in the rc
+  // file actually takes the name back out on a reload.
+  for (const stale of Object.keys(loadedAliases)) delete loadedAliases[stale];
   if (getConfig().useAliases) {
     for (const [alias, command] of aliases) {
       loadedAliases[alias] = parseCommand(command + " ", shell);
@@ -150,6 +163,45 @@ export const loadAliases = async (shell: Shell) => {
   shellDefinedNames = new Set([...aliases.keys(), ...functions, ...managedAliasNames]);
 };
 
+/**
+ * Names that, run at a prompt, can leave the table stale: they either define
+ * or remove a name directly, or pull in a file that does. `source`/`.` is
+ * taken unconditionally rather than pattern-matched against rc filenames —
+ * a sourced env script defining a project alias is exactly the case a filename
+ * heuristic would miss.
+ */
+const aliasMutatingCommands = new Set(["alias", "unalias", "source", "."]);
+
+/**
+ * Statement separators, so `git pull && source .envrc` is noticed. Splitting
+ * on them is enough to find the head of each statement; anything subtler
+ * (quoting, here-docs) would only add false negatives to a best-effort check.
+ */
+const statementSeparators = /[\n;|&]+/;
+
+export const changesShellDefinitions = (commandText: string): boolean =>
+  commandText.split(statementSeparators).some((statement) => aliasMutatingCommands.has(statement.trim().split(/\s+/, 1)[0] ?? ""));
+
+let reloadInFlight: Promise<void> | undefined;
+
+/**
+ * Re-reads the shell's definitions mid-session. Serialised, because each call
+ * spawns an interactive shell and evaluates a whole profile: a burst of
+ * `alias` lines pasted at the prompt should cost one reload, not one each. The
+ * in-flight run is reused rather than queued behind — it was started after the
+ * command that triggered it, so it already sees the new state.
+ */
+export const reloadAliases = (shell: Shell): Promise<void> => {
+  reloadInFlight ??= loadAliases(shell)
+    .catch((error) => {
+      log.debug({ msg: "failed to reload shell aliases", error });
+    })
+    .finally(() => {
+      reloadInFlight = undefined;
+    });
+  return reloadInFlight;
+};
+
 export const getAliasNames = () => aliasNames;
 
 export const isShellDefinedCommand = (command: string) => shellDefinedNames.has(command);
