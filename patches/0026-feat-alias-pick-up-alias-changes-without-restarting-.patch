+
+describe("changesShellDefinitions", () => {
+  test.each([
+    ["alias gs='git status'", true],
+    ["unalias gs", true],
+    ["source ~/.bashrc", true],
+    [". ~/.bash_aliases", true],
+    ["git pull && source .envrc", true],
+    ["  alias", true],
+    ["git status", false],
+    ["echo alias", false],
+    ["aliased --help", false],
+    ["", false],
+  ])("%s -> %s", (commandText, expected) => {
+    expect(changesShellDefinitions(commandText)).toBe(expected);
+  });
+});
+
+describe("loadAliases", () => {
+  test("drops names the shell no longer defines", async () => {
+    mockGetConfig.mockReturnValue({ useAliases: true });
+    mockExecuteShellCommand.mockReturnValue({ stdout: `alias gone='git status'`, status: 0 });
+    await loadAliases(Shell.Bash);
+    expect(getAliasNames()).toContain("gone");
+
+    mockExecuteShellCommand.mockReturnValue({ stdout: ``, status: 0 });
+    await loadAliases(Shell.Bash);
+
+    expect(getAliasNames()).not.toContain("gone");
+    expect(aliasExpand([{ token: "gone", complete: true, isOption: false, tokenLength: 4 }])).toEqual([
+      { token: "gone", complete: true, isOption: false, tokenLength: 4 },
+    ]);
+  });
+});
diff --git a/src/ui/ui-reinit.ts b/src/ui/ui-reinit.ts
index 2e03eb3..9dc9a47 100644
--- a/src/ui/ui-reinit.ts
+++ b/src/ui/ui-reinit.ts
@@ -3,7 +3,6 @@
 
 import chalk from "chalk";
 import { unpackResources } from "../utils/node.js";
-import { createShellConfigs } from "../utils/shell.js";
 import {
   shellResourcesPath,
   nativeResourcesPath,
@@ -13,6 +12,38 @@ import {
   versionResourcePath,
 } from "../utils/constants.js";
 import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { createShellConfigs, aliasSupportedShells } from "../utils/shell.js";
+import { bashStartupFiles, readShellDefinitions } from "../runtime/alias.js";
+
+/**
+ * A session reads the shell's aliases itself, at startup, so this reports
+ * rather than installs anything. It exists because the failure it describes is
+ * otherwise silent: an alias that lives in a file the shell never reads simply
+ * doesn't appear in the menu, with nothing to distinguish it from one termauto
+ * failed to parse.
+ */
+const renderShellDefinitions = async (): Promise<void> => {
+  for (const shell of aliasSupportedShells) {
+    const { aliases, functions } = await readShellDefinitions(shell);
+    const found = `${aliases.size} ${aliases.size === 1 ? "alias" : "aliases"}, ${functions.size} ${functions.size === 1 ? "function" : "functions"}`;
+    const mark = aliases.size + functions.size > 0 ? chalk.green("✓") : chalk.yellow("!");
+    process.stdout.write(`${mark} ${shell}: ${found}\n`);
+  }
+
+  // Only bash's list is worth printing: zsh is left to read its own rc files,
+  // whereas bash's are sourced by hand and so can be enumerated exactly.
+  const readable = bashStartupFiles.filter((file) => {
+    try {
+      fs.accessSync(path.join(os.homedir(), file.replace("~/", "")), fs.constants.R_OK);
+      return true;
+    } catch {
+      return false;
+    }
+  });
+  process.stdout.write(chalk.dim(`  bash startup files read: ${readable.length > 0 ? readable.join(", ") : "none found"}\n`));
+};
 
 export const render = async () => {
   fs.rmSync(shellResourcesPath, { recursive: true, force: true });
@@ -27,4 +58,6 @@ export const render = async () => {
   await unpackResources();
 
   process.stdout.write(chalk.green("✓") + " successfully installed inshellisense \n");
+
+  await renderShellDefinitions();
 };
