From d8d2e44b5bfe878040c515dbd4e1fd91463b0c66 Mon Sep 17 00:00:00 2001
From: AmirSalahY <amir@noury.ch>
Date: Thu, 6 Aug 2026 11:48:25 +0300
Subject: [PATCH 24/29] feat(alias): read bash aliases during zsh sessions

---
 src/runtime/alias.ts            | 16 +++++++++++--
 src/tests/runtime/alias.test.ts | 42 +++++++++++++++++++++++++++++++++
 2 files changed, 56 insertions(+), 2 deletions(-)

diff --git a/src/runtime/alias.ts b/src/runtime/alias.ts
index cc939d9..bbb6443 100644
--- a/src/runtime/alias.ts
+++ b/src/runtime/alias.ts
@@ -35,12 +35,24 @@ type ShellDefinitions = { aliases: Map<string, string>; functions: Set<string> }
 
 const noDefinitions = (): ShellDefinitions => ({ aliases: new Map(), functions: new Set() });
 
+const mergeDefinitions = (primary: ShellDefinitions, fallback: ShellDefinitions): ShellDefinitions => ({
+  aliases: new Map([...fallback.aliases, ...primary.aliases]),
+  functions: new Set([...fallback.functions, ...primary.functions]),
+});
+
+const bashStartupPrelude = [
+  "for __isterm_bash_startup in ~/.profile ~/.bash_profile ~/.bash_login ~/.bashrc ~/.bash_aliases; do",
+  '  [ -r "$__isterm_bash_startup" ] && . "$__isterm_bash_startup"',
+  "done",
+  "unset __isterm_bash_startup",
+].join("; ");
+
 const readBashDefinitions = async (): Promise<ShellDefinitions> => {
   const shellTarget = platform == "win32" ? await gitBashPath() : Shell.Bash;
   const { stdout, stderr, status } = await executeShellCommand({
     command: `'${shellTarget}'`,
     // `declare -F` prints "declare -f name"; the prefix is stripped below.
-    args: ["-i", "-c", `alias; echo ${functionsMarker}; declare -F`],
+    args: ["--noprofile", "--norc", "-i", "-c", `${bashStartupPrelude}; alias; echo ${functionsMarker}; declare -F`],
     cwd: process.cwd(),
     env: { ISTERM: "1" },
   });
@@ -115,7 +127,7 @@ const readShellDefinitions = async (shell: Shell): Promise<ShellDefinitions> =>
     case Shell.Bash:
       return readBashDefinitions();
     case Shell.Zsh:
-      return readZshDefinitions();
+      return mergeDefinitions(await readZshDefinitions(), await readBashDefinitions());
     default:
       return noDefinitions();
   }
diff --git a/src/tests/runtime/alias.test.ts b/src/tests/runtime/alias.test.ts
index 9563818..ecdfe74 100644
--- a/src/tests/runtime/alias.test.ts
+++ b/src/tests/runtime/alias.test.ts
@@ -68,4 +68,46 @@ ls='ls --color=auto'`,
     expect(aliasExpand([{ token: "git", complete: true, isOption: false, tokenLength: 3 }])).toMatchSnapshot();
     expect(aliasExpand([{ token: "ls", complete: true, isOption: false, tokenLength: 2 }])).toMatchSnapshot();
   });
+
+  test("loads common bash startup files before reading aliases", async () => {
+    mockGetConfig.mockReturnValue({ useAliases: true });
+    mockExecuteShellCommand.mockReturnValue({
+      stdout: `alias from_profile='echo profile'`,
+      status: 0,
+    });
+
+    await loadAliases(Shell.Bash);
+
+    expect(mockExecuteShellCommand).toHaveBeenCalledWith(
+      expect.objectContaining({
+        args: ["--noprofile", "--norc", "-i", "-c", expect.stringContaining("~/.bash_profile")],
+      }),
+    );
+    expect(aliasExpand([{ token: "from_profile", complete: true, isOption: false, tokenLength: 12 }])).toEqual([
+      { token: "echo", complete: true, isOption: false, tokenLength: 4 },
+      { token: "profile", complete: true, isOption: false, tokenLength: 7 },
+    ]);
+  });
+
+  test("adds bash aliases when the active shell is zsh", async () => {
+    mockGetConfig.mockReturnValue({ useAliases: true });
+    mockExecuteShellCommand.mockImplementation((options) => {
+      const { command } = options as { command: string };
+      if (command === Shell.Zsh) {
+        return { stdout: `from_zsh='git status'`, status: 0 };
+      }
+      return { stdout: `alias from_bash='git branch'`, status: 0 };
+    });
+
+    await loadAliases(Shell.Zsh);
+
+    expect(aliasExpand([{ token: "from_zsh", complete: true, isOption: false, tokenLength: 8 }])).toEqual([
+      { token: "git", complete: true, isOption: false, tokenLength: 3 },
+      { token: "status", complete: true, isOption: false, tokenLength: 6 },
+    ]);
+    expect(aliasExpand([{ token: "from_bash", complete: true, isOption: false, tokenLength: 9 }])).toEqual([
+      { token: "git", complete: true, isOption: false, tokenLength: 3 },
+      { token: "branch", complete: true, isOption: false, tokenLength: 6 },
+    ]);
+  });
 });
-- 
