From fe40e74ded98313bef5afedd2fdc3b9d8cf1ee81 Mon Sep 17 00:00:00 2001
From: AmirSalahY <amir@noury.ch>
Date: Sun, 2 Aug 2026 17:02:07 +0300
Subject: [PATCH 13/26] feat: brand the command as termauto, and report a real
 version

Three hardcoded identity strings broke a fork that installs under a different
name:

  - the generated init scripts under ~/.inshellisense/init/ re-exec the engine
    by bare name, so they pointed at a binary that isn't there and auto-start
    silently never fired;
  - commander printed `inshellisense` in every usage and error message;
  - getVersion() returned the literal `__VERSION__`, because that token is
    only substituted by the single-executable packaging step, which a plain
    tsc build never runs.

All three now read an env var (ISTERM_LAUNCHER, ISTERM_VERSION) and fall back
to the upstream behaviour when unset, so a stock build is unchanged.
---
 src/index.ts           |  4 +++-
 src/ui/ui-status.ts    |  7 ++++++-
 src/utils/constants.ts | 10 ++++++++++
 src/utils/shell.ts     | 32 +++++++++++++++++++-------------
 src/utils/version.ts   | 10 +++++++++-
 5 files changed, 47 insertions(+), 16 deletions(-)

diff --git a/src/index.ts b/src/index.ts
index 26c6c7d..9237b8c 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -59,7 +59,9 @@ terminal reports reliably.
 `;
 
 program
-  .name("inshellisense")
+  // The name commander prints in usage and error messages. It must match the
+  // binary the user actually invoked, or every `--help` example is uncopyable.
+  .name(process.env.ISTERM_LAUNCHER || "inshellisense")
   .description("IDE style command line auto complete")
   .version(getVersion(), "-v, --version", "output the current version")
   .action(action(program))
diff --git a/src/ui/ui-status.ts b/src/ui/ui-status.ts
index d173d99..f358f6c 100644
--- a/src/ui/ui-status.ts
+++ b/src/ui/ui-status.ts
@@ -3,11 +3,16 @@
 
 import chalk from "chalk";
 
+import { launcherName } from "../utils/constants.js";
+
 export const renderConfirmation = (live: boolean): string => {
   const statusMessage = live ? chalk.green("live") : chalk.red("not found");
   return `inshellisense session [${statusMessage}]\n`;
 };
 
 export const renderMissingResources = (): string => {
-  return chalk.red(`inshellisense resources out of date, run "is reinit" to refresh\n`);
+  // This path exits(1), and the shell hook is `<launcher> -s zsh ; exit` — so a
+  // wrong command name here leaves the user with a terminal that closes itself
+  // and an instruction that doesn't work.
+  return chalk.red(`resources out of date, run "${launcherName()} reinit" to refresh\n`);
 };
diff --git a/src/utils/constants.ts b/src/utils/constants.ts
index 2b0e9ef..7970bf1 100644
--- a/src/utils/constants.ts
+++ b/src/utils/constants.ts
@@ -19,6 +19,16 @@ const inshellisenseFolderName = ".inshellisense";
  */
 const resourcesRoot = process.env.ISTERM_RESOURCES_DIR || path.join(os.homedir(), inshellisenseFolderName);
 
+/**
+ * The name this build is invoked by on PATH.
+ *
+ * Baked into anything the user is told to type — commander's usage line, the
+ * "run X reinit" prompt — and into the generated shell init scripts, which
+ * re-exec the engine by bare name. An embedding launcher exports it; a stock
+ * install leaves it unset and stays `is`.
+ */
+export const launcherName = (): string => process.env.ISTERM_LAUNCHER || "is";
+
 export const allResourcesPath = resourcesRoot;
 export const loggingResourcesPath = path.join(resourcesRoot, "log");
 export const nativeResourcesPath = path.join(resourcesRoot, "native");
diff --git a/src/utils/shell.ts b/src/utils/shell.ts
index edbb1d4..01cb4fd 100644
--- a/src/utils/shell.ts
+++ b/src/utils/shell.ts
@@ -9,7 +9,7 @@ import fs from "node:fs";
 import os from "node:os";
 import fsAsync from "node:fs/promises";
 import util from "node:util";
-import { shellResourcesPath, initResourcesPath } from "./constants.js";
+import { shellResourcesPath, initResourcesPath, launcherName } from "./constants.js";
 import childProcess from "node:child_process";
 import { KeyPressEvent } from "../ui/suggestionManager.js";
 import log from "./log.js";
@@ -296,14 +296,20 @@ export const getShellSourceCommand = (shell: Shell): string => {
   return "";
 };
 
+/**
+ * The generated init scripts land in ~/.inshellisense/init/<shell>/ and invoke
+ * the engine by BARE NAME, so the name below has to match whatever is actually
+ * linked onto PATH. A mismatch is silent — the shell just never wraps itself.
+ */
 export const getShellConfig = (shell: Shell): string => {
+  const is = launcherName();
   switch (shell) {
     case Shell.Zsh:
       return `if [[ -z "\${ISTERM}" && $- = *i* && $- != *c* && -z "\${VSCODE_RESOLVING_ENVIRONMENT}" ]]; then
   if [[ -o login ]]; then
-    is -s zsh --login ; exit
+    ${is} -s zsh --login ; exit
   else
-    is -s zsh ; exit
+    ${is} -s zsh ; exit
   fi
 fi`;
     case Shell.Bash:
@@ -311,10 +317,10 @@ fi`;
   shopt -q login_shell
   login_shell=$?
   if [ $login_shell -eq 0 ]; then
-    is -s bash --login ; exit
+    ${is} -s bash --login ; exit
   else
-    is -s bash ; exit
-  fi 
+    ${is} -s bash ; exit
+  fi
 fi`;
     case Shell.Powershell:
     case Shell.Pwsh:
@@ -322,26 +328,26 @@ fi`;
 $__IsNoExitFlag = ([Environment]::GetCommandLineArgs() | Where-Object { $_ -imatch '^-noe(xit)?$' }).Count -gt 0
 $__IsInteractive = -not $__IsCommandFlag -or ($__IsCommandFlag -and $__IsNoExitFlag)
 if ([string]::IsNullOrEmpty($env:ISTERM) -and [Environment]::UserInteractive -and $__IsInteractive -and [string]::IsNullOrEmpty($env:VSCODE_RESOLVING_ENVIRONMENT)) {
-  is -s ${shell}
+  ${is} -s ${shell}
   Stop-Process -Id $pid
 }`;
     case Shell.Fish:
       return `if test -z "$ISTERM" && status --is-interactive && test -z "$VSCODE_RESOLVING_ENVIRONMENT"
   if status --is-login
-    is -s fish --login ; kill %self
+    ${is} -s fish --login ; kill %self
   else
-    is -s fish ; kill %self
-  end 
+    ${is} -s fish ; kill %self
+  end
 end`;
     case Shell.Xonsh:
       return `if 'ISTERM' not in \${...} and $XONSH_INTERACTIVE and 'VSCODE_RESOLVING_ENVIRONMENT' not in \${...}:
     if $XONSH_LOGIN:
-        is -s xonsh --login ; exit
+        ${is} -s xonsh --login ; exit
     else:
-        is -s xonsh ; exit`;
+        ${is} -s xonsh ; exit`;
     case Shell.Nushell:
       return `if "ISTERM" not-in $env and $nu.is-interactive and "VSCODE_RESOLVING_ENVIRONMENT" not-in $env {
-    if $nu.is-login { is -s nu --login ; exit } else { is -s nu ; exit }
+    if $nu.is-login { ${is} -s nu --login ; exit } else { ${is} -s nu ; exit }
 }`;
   }
   return "";
diff --git a/src/utils/version.ts b/src/utils/version.ts
index faff6e2..1ab55fb 100644
--- a/src/utils/version.ts
+++ b/src/utils/version.ts
@@ -3,4 +3,12 @@
 
 const version = "__VERSION__";
 
-export const getVersion = (): string => version;
+/**
+ * The literal above is rewritten by scripts/pkg.ts when building the single
+ * executable. A plain `tsc` build — which is how termauto runs the engine —
+ * never goes through that step, so `--version` printed the raw placeholder.
+ *
+ * ISTERM_VERSION lets the embedding launcher supply its own version instead;
+ * termauto's shim reads it from the checkout's package.json.
+ */
+export const getVersion = (): string => process.env.ISTERM_VERSION || (version.startsWith("__") ? "0.0.0-dev" : version);
