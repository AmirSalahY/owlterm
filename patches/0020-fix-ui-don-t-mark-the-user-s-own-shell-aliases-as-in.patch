+import { isAliasName } from "./alias.js";
 import { wcswidth } from "../utils/unicode.js";
 import fs from "node:fs";
 import path from "node:path";
@@ -83,6 +84,10 @@ const pathCommandExists = (command: string, cwd: string): boolean => {
 };
 
 const commandExists = (command: string, cwd: string): boolean => {
+  // Aliases are checked ahead of the cache: they land after the first
+  // keystrokes (shell aliases load asynchronously, managed ones can appear
+  // mid-session) so a cached miss must not pin a real command as invalid.
+  if (isAliasName(command)) return true;
   const key = `${cwd}\u0000${command}`;
   const cached = commandExistsCache.get(key);
   if (cached != null) return cached;
diff --git a/src/tests/runtime/commandLineColorAlias.test.ts b/src/tests/runtime/commandLineColorAlias.test.ts
new file mode 100644
index 0000000..361fb4e
--- /dev/null
+++ b/src/tests/runtime/commandLineColorAlias.test.ts
@@ -0,0 +1,34 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import { jest } from "@jest/globals";
+
+const mockIsAliasName = jest.fn<(command: string) => boolean>();
+
+jest.unstable_mockModule("../../runtime/alias.js", () => ({
+  isAliasName: mockIsAliasName,
+}));
+
+const { commandLineColorSpans, commandLineColorTypeAt } = await import("../../runtime/commandLineColor.js");
+
+const typeAtWord = (command: string, word: string) => {
+  const offset = command.indexOf(word);
+  return commandLineColorTypeAt(commandLineColorSpans(command), offset);
+};
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  mockIsAliasName.mockReturnValue(false);
+});
+
+test("treats a known alias as a valid command", () => {
+  mockIsAliasName.mockImplementation((command) => command === "gst");
+  expect(typeAtWord("gst --short", "gst")).toBe("subcommand");
+  expect(typeAtWord("gstt --short", "gstt")).toBe("invalidCommand");
+});
+
+test("checks aliases ahead of the miss cache", () => {
+  expect(typeAtWord("later-alias run", "later-alias")).toBe("invalidCommand");
+  mockIsAliasName.mockImplementation((command) => command === "later-alias");
+  expect(typeAtWord("later-alias run", "later-alias")).toBe("subcommand");
+});
