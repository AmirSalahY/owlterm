 src/runtime/commandLineColor.ts               |  5 ++
 .../runtime/commandLineColorAlias.test.ts     | 34 ++++++++++
 3 files changed, 80 insertions(+), 22 deletions(-)
 create mode 100644 src/tests/runtime/commandLineColorAlias.test.ts

