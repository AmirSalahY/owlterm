+    expect(m.update(press("right"))).toBe(true);
+    expect(term.written.join("")).toEqual("add ");
+  });
 });
 
 describe("Esc dismisses", () => {
@@ -246,6 +255,34 @@ describe("Enter submits", () => {
     expect(term.written).toEqual(["<clear>"]);
   });
 
+  it("ignores legacy config that asks Enter to accept", async () => {
+    const original = getConfig().keys.enter;
+    getConfig().keys.enter = "insert";
+    try {
+      const term = makeTerm("git ");
+      const m = await makeManager(term, [suggestion("status")]);
+
+      expect(m.update(enter)).toBe(false);
+      expect(term.written).toEqual(["<clear>"]);
+    } finally {
+      getConfig().keys.enter = original;
+    }
+  });
+
+  it("ignores an acceptSuggestion binding pointed at Enter", async () => {
+    const original = getConfig().bindings.acceptSuggestion;
+    getConfig().bindings.acceptSuggestion = { key: "return" };
+    try {
+      const term = makeTerm("git ");
+      const m = await makeManager(term, [suggestion("status")]);
+
+      expect(m.update(enter)).toBe(false);
+      expect(term.written).toEqual(["<clear>"]);
+    } finally {
+      getConfig().bindings.acceptSuggestion = original;
+    }
+  });
+
   it("also falls through when there is nothing left to accept", async () => {
     const term = makeTerm("git status");
     const m = await makeManager(term, [suggestion("status")], "status");
