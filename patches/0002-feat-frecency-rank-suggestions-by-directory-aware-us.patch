--- a/src/runtime/suggestion.ts
+++ b/src/runtime/suggestion.ts
@@ -12,6 +12,7 @@ import log from "../utils/log.js";
 import { escapePath } from "./utils.js";
 import { addPathSeparator, endsWithPathSeparator, getPathDirname, removePathSeparator, Shell } from "../utils/shell.js";
 import { getConfig } from "../utils/config.js";
+import { rankingBoost } from "../utils/frecency.js";
 
 export enum SuggestionIcons {
   File = "📄",
@@ -295,6 +296,25 @@ function adjustPathSuggestions(
   });
 }
 
+/**
+ * Sole ranking entry point — used by BOTH recommendation paths.
+ *
+ * Kept as one function on purpose: subcommand-driven and arg-driven completion
+ * previously each carried their own inline `sort`, and letting them drift apart
+ * would mean the same suggestion ranks differently depending on which code path
+ * produced it.
+ *
+ * The frecency boost is additive on top of the spec's own priority, so
+ * spec-declared intent still sets the baseline order.
+ */
+const rankSuggestions = (suggestions: Suggestion[], acceptedTokens: CommandToken[], cwd: string): Suggestion[] => {
+  const prefix = acceptedTokens.map((t) => t.token);
+  return suggestions
+    .map((s) => ({ suggestion: s, score: s.priority + rankingBoost(prefix, s.name, cwd) }))
+    .sort((a, b) => b.score - a.score)
+    .map((entry) => entry.suggestion);
+};
+
 const removeAcceptedSuggestions = (suggestions: Suggestion[], acceptedTokens: CommandToken[]): Suggestion[] => {
   const seen = new Set<string>(acceptedTokens.map((t) => t.token));
   return suggestions.filter((s) => s.allNames.every((n) => !seen.has(n)));
@@ -369,7 +389,7 @@ export const getSubcommandDrivenRecommendation = async (
           removeHomeDirectorySuggestion(
             removeAcceptedSuggestions(
               adjustPathSuggestions(
-                suggestions.sort((a, b) => b.priority - a.priority),
+                rankSuggestions(suggestions, acceptedTokens, cwd),
                 partialToken,
                 lastToken,
                 shell,
@@ -424,7 +444,7 @@ export const getArgDrivenRecommendation = async (
           removeHomeDirectorySuggestion(
             removeAcceptedSuggestions(
               adjustPathSuggestions(
-                suggestions.sort((a, b) => b.priority - a.priority),
+                rankSuggestions(suggestions, acceptedTokens, cwd),
                 partialToken,
                 lastToken,
                 shell,
