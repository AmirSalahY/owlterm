index 0000000..041b6f1
--- /dev/null
+++ b/src/runtime/icons.ts
@@ -0,0 +1,176 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+// Lives apart from suggestion.ts so that importing an icon doesn't drag in the
+// generator/runtime graph — suggestion.ts sits in an import cycle, and a `const`
+// export read from inside that cycle hits the temporal dead zone. (The enum this
+// replaced was hoisted, so the cycle never bit before.)
+
+import { getConfig, type IconStyle } from "../utils/config.js";
+import { hasNerdFont } from "../utils/nerdfont.js";
+
+type IconKey = "File" | "Folder" | "Subcommand" | "Option" | "Argument" | "Mixin" | "Shortcut" | "Special" | "Default";
+type IconSet = Record<IconKey, string>;
+
+/**
+ * Nerd Font glyphs (FontAwesome + Codicons + Devicons, private use area). Every
+ * one is single-cell, so the icon column can't shove the labels sideways the way
+ * the emoji set did — emoji are double-width, and the ones with a variation
+ * selector (🏝️) are inconsistently measured across terminals.
+ */
+const nerdIcons: IconSet = {
+  File: "", // nf-fa-file
+  Folder: "", // nf-fa-folder
+  Subcommand: "", // nf-fa-cog
+  Option: "", // nf-fa-wrench
+  Argument: "", // nf-fa-sliders
+  Mixin: "", // nf-fa-link
+  Shortcut: "", // nf-fa-bolt
+  Special: "", // nf-fa-star
+  Default: "", // nf-fa-circle
+};
+
+/**
+ * Geometric symbols that render in essentially any monospace font. The fallback
+ * when no Nerd Font is installed: monochrome and single-cell like the real icon
+ * set, so the menu keeps its shape either way.
+ */
+const unicodeIcons: IconSet = {
+  File: "▪",
+  Folder: "▸",
+  Subcommand: "◆",
+  Option: "⁃",
+  Argument: "◇",
+  Mixin: "⬡",
+  // ↯ rather than the more obvious ⚡, which is double-width and would be the one
+  // glyph in the set that pushes its label a cell out of line.
+  Shortcut: "↯",
+  Special: "★",
+  Default: "○",
+};
+
+/** Upstream's set, kept selectable — some people do prefer the colour. */
+const emojiIcons: IconSet = {
+  File: "📄",
+  Folder: "📁",
+  Subcommand: "📦",
+  Option: "🔗",
+  Argument: "💲",
+  Mixin: "🏝️",
+  Shortcut: "🔥",
+  Special: "⭐",
+  Default: "📀",
+};
+
+const noIcons: IconSet = { File: "", Folder: "", Subcommand: "", Option: "", Argument: "", Mixin: "", Shortcut: "", Special: "", Default: "" };
+
+const ICON_STYLES = ["nerd", "unicode", "emoji", "none"] as const;
+
+export const resolveIconStyle = (): Exclude<IconStyle, "auto"> => {
+  // Env override wins over the rc file: it makes the choice deterministic for
+  // tests, and lets `IS_ICONS=emoji is` try a set without editing config.
+  const override = process.env.IS_ICONS as Exclude<IconStyle, "auto"> | undefined;
+  if (override && (ICON_STYLES as readonly string[]).includes(override)) return override;
+
+  const configured = getConfig().theme.icons;
+  if (configured !== "auto") return configured;
+  return hasNerdFont() ? "nerd" : "unicode";
+};
+
+const activeIconSet = (): IconSet => {
+  switch (resolveIconStyle()) {
+    case "nerd":
+      return nerdIcons;
+    case "emoji":
+      return emojiIcons;
+    case "none":
+      return noIcons;
+    default:
+      return unicodeIcons;
+  }
+};
+
+/**
+ * Reads like the enum it replaced (`SuggestionIcons.Folder`) but resolves against
+ * whichever set is active, so callers and tests never hardcode one style.
+ */
+export const SuggestionIcons = new Proxy({} as IconSet, {
+  get: (_, key: string) => activeIconSet()[key as IconKey] ?? "",
+}) as IconSet;
+
+export const NerdFontIcons = {
+  alert: "\udb80\udc27",
+  android: "\ue70e",
+  apple: "\ue711",
+  asterisk: "\uf069",
+  aws: "\ue7ad",
+  azure: "\ue754",
+  box: "\uf1b2",
+  carrot: "\uef3b",
+  characters: "\udb82\udf34",
+  commandkey: "\udb81\ude33",
+  commit: "\ue729",
+  cpu: "\uf4bc",
+  database: "\ue706",
+  discord: "\uf1ff",
+  docker: "\ue7b0",
+  firebase: "\ue787",
+  flag: "\udb80\udd4f",
+  gcloud: "\udb84\uddf6",
+  git: "\ue702",
+  github: "\ue709",
+  gitlab: "\ue7eb",
+  gradle: "\ue7f2",
+  heroku: "\ue77b",
+  invite: "\udb83\udebb",
+  kubernetes: "\ue81d",
+  netlify: "\ue83c",
+  node: "\ued0d",
+  npm: "\ued0e",
+  slack: "\ue8a4",
+  string: "\udb84\udc21",
+  twitter: "\uf099",
+  vercel: "\ue8d3",
+  yarn: "\ue8ec",
+};
+
+export const getIcon = (icon: string | undefined, suggestionType: Fig.SuggestionType | undefined): string => {
+  const style = resolveIconStyle();
+  if (style === "none") return "";
+
+  // A spec-supplied literal glyph. Honoured except under "unicode", where the
+  // whole point is that nothing outside the basic monospace repertoire is drawn
+  // — a spec's stray 🍺 would be the one double-width cell in an otherwise
+  // aligned column.
+  // eslint-disable-next-line no-control-regex
+  if (icon && /[^\u0000-\u00ff]/.test(icon) && style !== "unicode") {
+    return icon;
+  }
+  if (icon && icon.startsWith("fig://icon?type=") && style === "nerd") {
+    const iconType = icon.split("fig://icon?type=")[1].toLowerCase();
+    const iconUtf = NerdFontIcons[iconType as keyof typeof NerdFontIcons];
+    if (iconUtf != null && iconUtf !== "") {
+      return iconUtf;
+    }
+  }
+
+  switch (suggestionType) {
+    case "arg":
+      return SuggestionIcons.Argument;
+    case "file":
+      return SuggestionIcons.File;
+    case "folder":
+      return SuggestionIcons.Folder;
+    case "option":
+      return SuggestionIcons.Option;
+    case "subcommand":
+      return SuggestionIcons.Subcommand;
+    case "mixin":
+      return SuggestionIcons.Mixin;
+    case "shortcut":
+      return SuggestionIcons.Shortcut;
+    case "special":
+      return SuggestionIcons.Special;
+  }
+  return SuggestionIcons.Default;
+};
