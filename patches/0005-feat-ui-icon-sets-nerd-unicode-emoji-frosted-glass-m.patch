+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+/**
+ * Nerd Fonts are how a terminal gets FontAwesome/Devicons/Codicons: the glyphs
+ * live in the font's private use area, so they only render if the font the
+ * terminal is configured with is a patched one. There is no way to ask a
+ * terminal which font it is using, so the best available signal is whether a
+ * patched font is installed at all — someone who installed one is essentially
+ * always using it.
+ *
+ * Wrong in one direction only: a user with a Nerd Font installed but not
+ * selected sees tofu, and sets `theme.icons = "unicode"` to opt out. The
+ * reverse (patched font in use but undetected) just means plainer icons.
+ */
+const FONT_DIRS = (): string[] => {
+  const home = os.homedir();
+  switch (process.platform) {
+    case "darwin":
+      return [path.join(home, "Library", "Fonts"), "/Library/Fonts", "/System/Library/Fonts"];
+    case "win32":
+      return [path.join(process.env.LOCALAPPDATA ?? path.join(home, "AppData", "Local"), "Microsoft", "Windows", "Fonts"), path.join(process.env.WINDIR ?? "C:\\Windows", "Fonts")];
+    default:
+      return [path.join(home, ".local", "share", "fonts"), path.join(home, ".fonts"), "/usr/share/fonts", "/usr/local/share/fonts"];
+  }
+};
+
+// "JetBrainsMonoNerdFont-Regular.ttf", "Hack Nerd Font Mono.ttf", "MesloLGS NF.ttf"
+const NERD_FONT_FILE = /nerd[ _-]?font|\bNF\b|NerdFont/i;
+
+const scan = (dir: string, depth: number): boolean => {
+  let entries: fs.Dirent[];
+  try {
+    entries = fs.readdirSync(dir, { withFileTypes: true });
+  } catch {
+    return false;
+  }
+  for (const entry of entries) {
+    if (entry.isDirectory()) {
+      // System font trees nest a level or two (e.g. /usr/share/fonts/truetype/...).
+      if (depth > 0 && scan(path.join(dir, entry.name), depth - 1)) return true;
+    } else if (NERD_FONT_FILE.test(entry.name)) {
+      return true;
+    }
+  }
+  return false;
+};
+
+let cached: boolean | undefined;
+
+/** Cached for the process: fonts don't get installed mid-session. */
+export const hasNerdFont = (): boolean => {
+  if (cached != null) return cached;
+  cached = FONT_DIRS().some((dir) => scan(dir, 2));
+  return cached;
+};
+
+/** Test seam — also lets `is doctor` report both branches. */
+export const resetNerdFontCache = (value?: boolean): void => {
+  cached = value;
+};
