+          // useNerdFont predates theme.icons and only ever gated fig:// icon URLs.
+          // Honoured as a shorthand so existing rc files keep working.
+          icons: config?.theme?.icons ?? (config?.useNerdFont ? "nerd" : globalConfig.theme.icons),
         },
       };
     }
