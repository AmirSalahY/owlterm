new file mode 100644
index 0000000..7876013
--- /dev/null
+++ b/src/tests/runtime/icons.test.ts
@@ -0,0 +1,95 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import { getIcon, resolveIconStyle, SuggestionIcons } from "../../runtime/icons.js";
+import { wcswidth } from "../../utils/unicode.js";
+
+const withStyle = <T>(style: string, fn: () => T): T => {
+  const previous = process.env.IS_ICONS;
+  process.env.IS_ICONS = style;
+  try {
+    return fn();
+  } finally {
+    if (previous == null) delete process.env.IS_ICONS;
+    else process.env.IS_ICONS = previous;
+  }
+};
+
+const ALL_KEYS = ["File", "Folder", "Subcommand", "Option", "Argument", "Mixin", "Shortcut", "Special", "Default"] as const;
+
+afterEach(() => {
+  process.env.IS_ICONS = "unicode";
+});
+
+describe("icon style resolution", () => {
+  it("honours an explicit style over auto-detection", () => {
+    (["nerd", "unicode", "emoji", "none"] as const).forEach((style) => {
+      expect(withStyle(style, resolveIconStyle)).toEqual(style);
+    });
+  });
+
+  it("ignores an unrecognised style rather than rendering nothing", () => {
+    expect(withStyle("fontawesome", resolveIconStyle)).not.toEqual("fontawesome");
+  });
+});
+
+describe("icon sets", () => {
+  // The renderer reserves the icon column by measured width. A double-width glyph
+  // in a set therefore shunts that one row's label a cell out of line — the exact
+  // ragged column the emoji default was replaced to fix.
+  it.each(["nerd", "unicode"])("renders every %s icon in a single cell", (style) => {
+    withStyle(style, () => {
+      ALL_KEYS.forEach((key) => {
+        expect([key, wcswidth(SuggestionIcons[key])]).toEqual([key, 1]);
+      });
+    });
+  });
+
+  it('emits nothing at all for "none"', () => {
+    withStyle("none", () => {
+      ALL_KEYS.forEach((key) => expect(SuggestionIcons[key]).toEqual(""));
+      expect(getIcon(undefined, "folder")).toEqual("");
+      // Even a spec that hands us an explicit glyph stays suppressed.
+      expect(getIcon("🍺", "arg")).toEqual("");
+    });
+  });
+
+  it("maps suggestion types to distinct glyphs", () => {
+    withStyle("unicode", () => {
+      const glyphs = [getIcon(undefined, "file"), getIcon(undefined, "folder"), getIcon(undefined, "subcommand"), getIcon(undefined, "option")];
+      expect(new Set(glyphs).size).toEqual(glyphs.length);
+    });
+  });
+
+  it("falls back to the default glyph for an unknown type", () => {
+    withStyle("unicode", () => {
+      expect(getIcon(undefined, undefined)).toEqual(SuggestionIcons.Default);
+    });
+  });
+});
+
+describe("spec-supplied icons", () => {
+  it("passes a literal glyph through under nerd and emoji", () => {
+    expect(withStyle("nerd", () => getIcon("🍺", "arg"))).toEqual("🍺");
+    expect(withStyle("emoji", () => getIcon("🍺", "arg"))).toEqual("🍺");
+  });
+
+  it("suppresses a literal glyph under unicode, where alignment is the point", () => {
+    withStyle("unicode", () => {
+      expect(getIcon("🍺", "arg")).toEqual(SuggestionIcons.Argument);
+    });
+  });
+
+  it("resolves fig:// icon urls to nerd glyphs only under nerd", () => {
+    const url = "fig://icon?type=git";
+    expect(withStyle("nerd", () => getIcon(url, "subcommand"))).toEqual("");
+    // Without a patched font that codepoint is tofu, so fall back to the type icon.
+    expect(withStyle("unicode", () => getIcon(url, "subcommand"))).toEqual(withStyle("unicode", () => SuggestionIcons.Subcommand));
+  });
+
+  it("falls back to the type icon for an unmapped fig:// icon url", () => {
+    withStyle("nerd", () => {
+      expect(getIcon("fig://icon?type=notathing", "option")).toEqual(SuggestionIcons.Option);
+    });
+  });
+});
