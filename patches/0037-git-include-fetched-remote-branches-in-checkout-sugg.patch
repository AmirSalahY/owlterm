+
 describe(`parseCommand`, () => {
   testData.forEach(({ command, name, skip, maxSuggestions }) => {
     if (skip) return;
@@ -163,4 +183,22 @@ describe(`getCommandSuggestions`, () => {
       fs.rmSync(cwd, { recursive: true, force: true });
     }
   });
+
+  test("suggests fetched remote-only branches from command position", async () => {
+    const repo = makeGitRepoWithRemoteBranch();
+    try {
+      const suggestions = await getSuggestions("fetched", repo.cwd, Shell.Bash);
+      expect(suggestions?.suggestions).toEqual(
+        expect.arrayContaining([
+          expect.objectContaining({
+            name: "feature/fetched-only",
+            type: "branch",
+            insertValue: "git checkout feature/fetched-only ",
+          }),
+        ]),
+      );
+    } finally {
+      fs.rmSync(repo.root, { recursive: true, force: true });
+    }
+  });
 });
