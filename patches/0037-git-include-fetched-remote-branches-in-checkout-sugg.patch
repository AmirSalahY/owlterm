+++ b/src/tests/runtime/runtime.test.ts
@@ -49,6 +49,26 @@ const makeGitRepo = (): string => {
   return dir;
 };
 
+const makeGitRepoWithRemoteBranch = (): { root: string; cwd: string } => {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "inshellisense-git-remote-"));
+  const upstream = path.join(root, "upstream");
+  const remote = path.join(root, "remote.git");
+  const cwd = path.join(root, "client");
+
+  fs.mkdirSync(upstream);
+  childProcess.execFileSync("git", ["init", "-b", "main"], { cwd: upstream, stdio: "ignore" });
+  childProcess.execFileSync("git", ["config", "user.email", "test@example.test"], { cwd: upstream, stdio: "ignore" });
+  childProcess.execFileSync("git", ["config", "user.name", "Test User"], { cwd: upstream, stdio: "ignore" });
+  childProcess.execFileSync("git", ["commit", "--allow-empty", "-m", "initial"], { cwd: upstream, stdio: "ignore" });
+  childProcess.execFileSync("git", ["checkout", "-b", "feature/fetched-only"], { cwd: upstream, stdio: "ignore" });
+  childProcess.execFileSync("git", ["commit", "--allow-empty", "-m", "remote branch"], { cwd: upstream, stdio: "ignore" });
+  childProcess.execFileSync("git", ["checkout", "main"], { cwd: upstream, stdio: "ignore" });
+  childProcess.execFileSync("git", ["clone", "--bare", upstream, remote], { cwd: root, stdio: "ignore" });
+  childProcess.execFileSync("git", ["clone", remote, cwd], { cwd: root, stdio: "ignore" });
