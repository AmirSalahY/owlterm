From 0f1722f88540c7a676a95df45fbbfcd45017e0dd Mon Sep 17 00:00:00 2001
From: AmirSalahY <hello@noury.ch>
Date: Sun, 2 Aug 2026 12:56:54 +0300
Subject: [PATCH 08/31] fix(ui): widen unicode icon coverage, and document why
 it is the safe set
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Swaps the two glyphs with the worst font coverage: U+2043 hyphen-bullet and
U+2B21 white hexagon are absent from most system monospace fonts. Middle dot and
section sign are present natively in Menlo — the font a VS Code terminal falls
back to, and the one that was rendering nothing — taking it from 7/9 to 9/9 with
no reliance on substitution.

Records the asymmetry that actually governs this: assigned codepoints get OS font
fallback (Menlo has no emoji yet draws them; Monaco has no U+256D yet draws
rounded corners), while the private use area gets none, because no system font
claims it. That is why Codicons need their patched font selected in every
terminal and unicode does not.

Adds scripts/icon-check.sh to print all three sets raw in a given terminal.
---
 src/runtime/icons.ts                          | 17 +++--
 .../__snapshots__/runtime.test.ts.snap        | 72 +++++++++----------
 2 files changed, 48 insertions(+), 41 deletions(-)

diff --git a/src/runtime/icons.ts b/src/runtime/icons.ts
index fb5eba0..f6fb3b8 100644
--- a/src/runtime/icons.ts
+++ b/src/runtime/icons.ts
@@ -39,17 +39,24 @@ const codiconIcons: IconSet = {
 };
 
 /**
- * Geometric symbols that render in essentially any monospace font. The fallback
- * when no Nerd Font is installed: monochrome and single-cell like the Codicon
- * set, so the menu keeps its shape either way.
+ * The set that works in every terminal, and the fallback when a patched font
+ * isn't in use.
+ *
+ * These are real assigned codepoints, not private use area ones, which is the
+ * whole difference: when a terminal's font lacks one, the OS substitutes a font
+ * that has it. Nothing substitutes for the PUA, because no system font claims
+ * those codepoints — which is exactly why Codicons vanish where these survive.
+ *
+ * Monochrome and single-cell like the Codicon set, so the menu keeps its shape
+ * either way.
  */
 const unicodeIcons: IconSet = {
   File: "▪",
   Folder: "▸",
   Subcommand: "◆",
-  Option: "⁃",
+  Option: "·",
   Argument: "◇",
-  Mixin: "⬡",
+  Mixin: "§",
   // ↯ rather than the more obvious ⚡, which is double-width and would be the one
   // glyph in the set that pushes its label a cell out of line.
   Shortcut: "↯",
