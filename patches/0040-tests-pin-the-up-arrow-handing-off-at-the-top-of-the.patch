From caf29dff94bf1a3501710182ccc9315a5c8540c9 Mon Sep 17 00:00:00 2001
From: AmirSalahY <amir@noury.ch>
Date: Sun, 30 Aug 2026 10:57:37 +0300
Subject: [PATCH 40/41] tests: pin the up arrow handing off at the top of the
 menu
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The clamp it replaced looked harmless — the index simply stopped at zero — so
the regression to guard against is someone reinstating it without noticing the
key stops reaching the shell.
---
 src/tests/utils/suggestionManager.test.ts | 37 +++++++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/src/tests/utils/suggestionManager.test.ts b/src/tests/utils/suggestionManager.test.ts
index e3a11ee..215fe70 100644
--- a/src/tests/utils/suggestionManager.test.ts
+++ b/src/tests/utils/suggestionManager.test.ts
@@ -114,3 +114,40 @@ test("does not consume suggestion bindings when the UI is hidden", async () => {
   expect(manager.update({ name: "tab", sequence: "\t", shift: false, ctrl: false }, false)).toBe(false);
   expect(writes).toEqual([]);
 });
+
+test("hands the up arrow to the shell once the highlight is on the first row", async () => {
+  const writes: string[] = [];
+  const terminal = {
+    cwd: process.cwd(),
+    cols: 80,
+    write: (data: string) => writes.push(data),
+    getCommandState: () => ({ commandText: "first", cursorTerminated: true, hasOutput: false }),
+    getCursorState: () => ({ cursorX: 0 }),
+  } as unknown as ISTerm;
+  const runtime = Promise.resolve({
+    getSuggestions: async (): Promise<SuggestionBlob> => ({
+      suggestions: ["one", "two"].map((name) => ({ name, allNames: [name], icon: "*", priority: 50 })),
+    }),
+  });
+  const manager = new SuggestionManager(terminal, Shell.Bash, runtime);
+  await manager.exec();
+
+  const down = { name: "down", sequence: "\u001B[B", shift: false, ctrl: false };
+  const up = { name: "up", sequence: "\u001B[A", shift: false, ctrl: false };
+
+  // Moving off the first row and back again stays inside the menu.
+  expect(manager.update(down)).toBe(true);
+  expect(manager.update(up)).toBe(true);
+  expect(
+    manager
+      .render("below", 0)
+      .map((patch) => patch.data)
+      .join("\n"),
+  ).toContain("one");
+
+  // A second up-arrow has nowhere left to go, so it belongs to shell history:
+  // report it unhandled and take the menu down.
+  expect(manager.update(up)).toBe(false);
+  expect(manager.render("below", 0)).toEqual([]);
+  expect(writes).toEqual([]);
+});
