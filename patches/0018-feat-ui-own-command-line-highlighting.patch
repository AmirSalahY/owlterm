+  private _commandLineColor(type: CommandLineColorType | undefined): string | undefined {
+    if (type == null) return undefined;
+    if (type === "invalidCommand") return "#FF453A";
+    const { colorByType, foreground, types } = getConfig().theme;
+    if (!colorByType) return undefined;
+    return types[type as keyof typeof types] || foreground;
+  }
+
+  private _fgAnsi(hex: string | undefined): string {
+    if (hex == null) return ansi.resetColor;
+    const normalized = hex.trim().replace(/^#/, "");
+    if (!/^[0-9a-fA-F]{6}$/.test(normalized)) return ansi.resetColor;
+    const [r, g, b] = [0, 2, 4].map((idx) => parseInt(normalized.slice(idx, idx + 2), 16));
+    return `\x1b[38;2;${r};${g};${b}m`;
+  }
+
+  getCommandLinePatch(bufferType: BufferType = "active"): string {
+    const commandText = this.#commandManager.getState().commandText;
+    const location = this.#commandManager.getCommandLocation();
+    if (!commandText || location == null || this.isAlternateBuffer()) return "";
+
+    const buffer = this._getBuffer(bufferType);
+    const viewportStart = buffer.baseY;
+    const viewportEnd = buffer.baseY + this.#term.rows - 1;
+    const spans = commandLineColorSpans(commandText, this.cwd || process.cwd());
+    const commandWidth = wcswidth(commandText);
+    let consumed = 0;
+    let y = location.line;
+    let x = location.x;
+    const lines: string[] = [];
+
+    while (consumed < commandWidth && y <= viewportEnd) {
+      const line = buffer.getLine(y);
+      if (line == null) break;
+      const row = y - buffer.baseY;
+      if (y >= viewportStart && row >= 0 && row < this.#term.rows) {
+        let rendered = ansi.cursorTo({ x: x + 1, y: row + 1 });
+        let currentColor = "";
+        for (; x < line.length && consumed < commandWidth; x++) {
+          const cell = line.getCell(x) as unknown as ICellData | undefined;
+          const width = cell?.getWidth() ?? 1;
+          if (width === 0) continue;
+
+          const color = this._fgAnsi(this._commandLineColor(commandLineColorTypeAt(spans, consumed)));
+          if (color !== currentColor) {
+            rendered += color;
+            currentColor = color;
+          }
+
+          const chars = cell?.getChars() ?? "";
+          rendered += chars === "" ? ansi.cursorForward(width) : chars;
+          consumed += Math.max(width, wcswidth(chars));
+        }
+        lines.push(rendered + ansi.resetColor);
+      } else {
+        consumed += Math.max(0, line.length - x);
+      }
+      y += 1;
+      x = 0;
+    }
+
+    return lines.join("");
+  }
+
   private _getLinePatch(buffer: IBuffer, y: number, patch?: ISTermPatch): string {
