     const viewportEnd = buffer.baseY + this.#term.rows - 1;
diff --git a/src/runtime/commandLineColor.ts b/src/runtime/commandLineColor.ts
new file mode 100644
index 0000000..211b013
--- /dev/null
+++ b/src/runtime/commandLineColor.ts
@@ -0,0 +1,124 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import { wcswidth } from "../utils/unicode.js";
+import fs from "node:fs";
+import path from "node:path";
+
+export type CommandLineColorType = Fig.SuggestionType | "invalidCommand";
+
+export type CommandLineColorSpan = {
+  start: number;
+  end: number;
+  type: CommandLineColorType;
+};
+
+const operator = /^(;|\||\|\||&&)$/;
+const commandExistsCache = new Map<string, boolean>();
+const shellBuiltins = new Set([
+  ".",
+  ":",
+  "alias",
+  "bg",
+  "bindkey",
+  "break",
+  "builtin",
+  "cd",
+  "command",
+  "continue",
+  "dirs",
+  "disown",
+  "echo",
+  "eval",
+  "exec",
+  "exit",
+  "export",
+  "false",
+  "fc",
+  "fg",
+  "hash",
+  "history",
+  "jobs",
+  "kill",
+  "let",
+  "local",
+  "popd",
+  "print",
+  "printf",
+  "pushd",
+  "pwd",
+  "read",
+  "readonly",
+  "return",
+  "set",
+  "shift",
+  "source",
+  "test",
+  "times",
+  "trap",
+  "true",
+  "type",
+  "typeset",
+  "ulimit",
+  "unalias",
+  "unset",
+  "wait",
+]);
+
+const executable = (candidate: string): boolean => {
+  try {
+    fs.accessSync(candidate, fs.constants.X_OK);
+    return fs.statSync(candidate).isFile();
+  } catch {
+    return false;
+  }
+};
+
+const pathCommandExists = (command: string, cwd: string): boolean => {
+  if (command.includes("/")) return executable(path.resolve(cwd, command));
+  return (process.env.PATH ?? "")
+    .split(path.delimiter)
+    .filter(Boolean)
+    .some((dir) => executable(path.join(dir, command)));
+};
+
+const commandExists = (command: string, cwd: string): boolean => {
+  const key = `${cwd}\u0000${command}`;
+  const cached = commandExistsCache.get(key);
+  if (cached != null) return cached;
+  const exists = shellBuiltins.has(command) || pathCommandExists(command, cwd);
+  commandExistsCache.set(key, exists);
+  return exists;
+};
+
+export const commandLineColorSpans = (commandText: string, cwd = process.cwd()): CommandLineColorSpan[] => {
+  const spans: CommandLineColorSpan[] = [];
+  let expectingCommand = true;
+
+  for (const match of commandText.matchAll(/\S+/g)) {
+    const raw = match[0];
+    const start = wcswidth(commandText.slice(0, match.index));
+    const end = start + wcswidth(raw);
+
+    if (operator.test(raw)) {
+      spans.push({ start, end, type: "special" });
+      expectingCommand = true;
+      continue;
+    }
+
+    if (raw.includes("=") && expectingCommand && !raw.startsWith("-")) {
+      spans.push({ start, end, type: "special" });
+      continue;
+    }
+
+    const type: CommandLineColorType = expectingCommand ? (commandExists(raw, cwd) ? "subcommand" : "invalidCommand") : raw.startsWith("-") ? "option" : "arg";
+    spans.push({ start, end, type });
+    expectingCommand = false;
+  }
+
+  return spans;
+};
+
+export const commandLineColorTypeAt = (spans: CommandLineColorSpan[], offset: number): CommandLineColorType | undefined => {
+  return spans.find((span) => offset >= span.start && offset < span.end)?.type;
+};
diff --git a/src/tests/runtime/commandLineColor.test.ts b/src/tests/runtime/commandLineColor.test.ts
new file mode 100644
index 0000000..2ccde37
--- /dev/null
+++ b/src/tests/runtime/commandLineColor.test.ts
@@ -0,0 +1,32 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+import { commandLineColorSpans, commandLineColorTypeAt } from "../../runtime/commandLineColor.js";
+
+const typeAtWord = (command: string, word: string) => {
+  const offset = command.indexOf(word);
+  return commandLineColorTypeAt(commandLineColorSpans(command), offset);
+};
+
+test("classifies command words by shell role", () => {
+  const command = "FOO=bar rtk vercel alias set https://example.test --scope amirsalahys-projects";
+  expect(typeAtWord(command, "FOO=bar")).toBe("special");
+  expect(typeAtWord(command, "rtk")).toBe("subcommand");
+  expect(typeAtWord(command, "vercel")).toBe("arg");
+  expect(typeAtWord(command, "--scope")).toBe("option");
+  expect(typeAtWord(command, "amirsalahys-projects")).toBe("arg");
+});
+
+test("marks unknown command-position words as invalid", () => {
+  const command = "definitely-not-a-real-command --force value";
+  expect(typeAtWord(command, "definitely-not-a-real-command")).toBe("invalidCommand");
+  expect(typeAtWord(command, "--force")).toBe("option");
+  expect(typeAtWord(command, "value")).toBe("arg");
+});
+
+test("starts a new command after shell operators", () => {
+  const command = "git status && npm test";
+  expect(typeAtWord(command, "git")).toBe("subcommand");
+  expect(typeAtWord(command, "&&")).toBe("special");
+  expect(typeAtWord(command, "npm")).toBe("subcommand");
+});
