From 2cda609012217392bf69ea67a50b166d13849967 Mon Sep 17 00:00:00 2001
From: AmirSalahY <amir@noury.ch>
Date: Sat, 8 Aug 2026 03:20:18 +0300
Subject: [PATCH 28/35] rebrand command references from termauto to owlterm

The launcher and default config file are being renamed; update the
strings this engine bakes in so they match (managed-alias output,
error messages, default config filename/env var, and comments).
---
 src/ui/ui-reinit.ts         | 2 +-
 src/utils/config.ts         | 6 +++---
 src/utils/managedAliases.ts | 6 +++---
 src/utils/version.ts        | 4 ++--
 4 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/src/ui/ui-reinit.ts b/src/ui/ui-reinit.ts
index 9dc9a47..d91c0a4 100644
--- a/src/ui/ui-reinit.ts
+++ b/src/ui/ui-reinit.ts
@@ -21,7 +21,7 @@ import { bashStartupFiles, readShellDefinitions } from "../runtime/alias.js";
  * A session reads the shell's aliases itself, at startup, so this reports
  * rather than installs anything. It exists because the failure it describes is
  * otherwise silent: an alias that lives in a file the shell never reads simply
- * doesn't appear in the menu, with nothing to distinguish it from one termauto
+ * doesn't appear in the menu, with nothing to distinguish it from one owlterm
  * failed to parse.
  */
 const renderShellDefinitions = async (): Promise<void> => {
diff --git a/src/utils/config.ts b/src/utils/config.ts
index c6ae61f..b4a67a4 100644
--- a/src/utils/config.ts
+++ b/src/utils/config.ts
@@ -301,10 +301,10 @@ const xdgPath = path.join(os.homedir(), ".config", "inshellisense", xdgFile);
 
 const configPaths = [rcPath, xdgPath];
 
-const defaultConfigFile = "termauto.config.json";
+const defaultConfigFile = "owlterm.config.json";
 
 const findDefaultConfigPath = (): string => {
-	const configured = process.env.TERMAUTO_DEFAULT_CONFIG;
+	const configured = process.env.OWLTERM_DEFAULT_CONFIG;
 	if (configured && fs.existsSync(configured)) return configured;
 
 	let dir = path.dirname(fileURLToPath(import.meta.url));
@@ -315,7 +315,7 @@ const findDefaultConfigPath = (): string => {
 		if (parent === dir) break;
 		dir = parent;
 	}
-	throw new Error(`termauto default config not found: set TERMAUTO_DEFAULT_CONFIG or add ${defaultConfigFile} at the repository root`);
+	throw new Error(`owlterm default config not found: set OWLTERM_DEFAULT_CONFIG or add ${defaultConfigFile} at the repository root`);
 };
 
 const cloneConfig = (config: Config): Config => JSON.parse(JSON.stringify(config)) as Config;
diff --git a/src/utils/managedAliases.ts b/src/utils/managedAliases.ts
index 7e392da..fd7b6c2 100644
--- a/src/utils/managedAliases.ts
+++ b/src/utils/managedAliases.ts
@@ -130,8 +130,8 @@ export const renderManagedAliasInit = async (shell: Shell): Promise<string> => {
 
   const aliases = await readManagedAliases();
   const lines = [
-    "# termauto managed aliases",
-    "# Generated by `termauto alias init`; edit with `termauto alias set/remove`.",
+    "# owlterm managed aliases",
+    "# Generated by `owlterm alias init`; edit with `owlterm alias set/remove`.",
   ];
   for (const alias of aliases) {
     lines.push(`${alias.name}() {`);
@@ -170,7 +170,7 @@ export const executeManagedAlias = async (alias: ManagedAlias, parameterValues:
   const child = childProcess.spawn(tokens[0], tokens.slice(1), { stdio: "inherit" });
   return await new Promise((resolve) => {
     child.on("error", (error) => {
-      process.stderr.write(`termauto alias: ${error.message}\n`);
+      process.stderr.write(`owlterm alias: ${error.message}\n`);
       resolve(127);
     });
     child.on("exit", (code, signal) => {
diff --git a/src/utils/version.ts b/src/utils/version.ts
index 1ab55fb..8538ea8 100644
--- a/src/utils/version.ts
+++ b/src/utils/version.ts
@@ -5,10 +5,10 @@ const version = "__VERSION__";
 
 /**
  * The literal above is rewritten by scripts/pkg.ts when building the single
- * executable. A plain `tsc` build — which is how termauto runs the engine —
+ * executable. A plain `tsc` build — which is how owlterm runs the engine —
  * never goes through that step, so `--version` printed the raw placeholder.
  *
  * ISTERM_VERSION lets the embedding launcher supply its own version instead;
- * termauto's shim reads it from the checkout's package.json.
+ * owlterm's shim reads it from the checkout's package.json.
  */
 export const getVersion = (): string => process.env.ISTERM_VERSION || (version.startsWith("__") ? "0.0.0-dev" : version);
-- 
