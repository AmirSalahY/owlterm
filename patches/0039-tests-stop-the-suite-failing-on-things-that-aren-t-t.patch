From d445b09e6225d7a0cce7b9ca4e506176f29becbd Mon Sep 17 00:00:00 2001
From: AmirSalahY <amir@noury.ch>
Date: Sun, 30 Aug 2026 10:51:59 +0300
Subject: [PATCH 39/40] tests: stop the suite failing on things that aren't the
 code
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Three renderer tests had been failing since the command-line highlighting work
landed: their fake terminal never grew a getCommandLinePatch, so every render
threw before reaching its assertions. Stub it as empty, which leaves those tests
asserting what they were written to assert.

The brew case asked for a cask, and `brew casks` needs the online API and comes
back empty on a machine with untrusted taps — so it measured the developer's
Homebrew state rather than the generator. A formula exercises the same code path
without that dependency.

Finally, the dotnet case queries the live NuGet API and lands within a few
hundred milliseconds of Jest's 5s default, so it fails on nothing worse than a
slow connection. Give the table a per-case timeout and let that one have 30s.
---
 src/tests/runtime/runtime.test.ts          | 33 ++++++++++++++--------
 src/tests/utils/suggestionRenderer.test.ts |  6 ++++
 2 files changed, 27 insertions(+), 12 deletions(-)

diff --git a/src/tests/runtime/runtime.test.ts b/src/tests/runtime/runtime.test.ts
index 652b377..5dccbc2 100644
--- a/src/tests/runtime/runtime.test.ts
+++ b/src/tests/runtime/runtime.test.ts
@@ -30,7 +30,9 @@ const testData = [
   { name: "nestedNonCommands", command: "az az ", skip: true }, // no longer supported
   { name: "loadSpec", command: "aws acm add", skip: true }, // no longer loaded
   { name: "noArgsArgumentGiven", command: "gcc lab ", maxSuggestions: 3 },
-  { name: "generatorUsingPartialInput", command: "dotnet add package Microsoft.Azure.WebJobs.Cor", maxSuggestions: 1 },
+  // Queries the live NuGet API, which routinely sits just under Jest's 5s
+  // default and tips over it on a slow connection.
+  { name: "generatorUsingPartialInput", command: "dotnet add package Microsoft.Azure.WebJobs.Cor", maxSuggestions: 1, timeout: 30_000 },
   { name: "pathSuggestion", command: "source she" },
   { name: "pathNestedSuggestion", command: "source .github/work" },
   { name: "pathWithFileSuggestion", command: "source shell/", maxSuggestions: 1 },
@@ -70,25 +72,32 @@ const makeGitRepoWithRemoteBranch = (): { root: string; cwd: string } => {
 };
 
 describe(`parseCommand`, () => {
-  testData.forEach(({ command, name, skip, maxSuggestions }) => {
+  testData.forEach(({ command, name, skip, maxSuggestions, timeout }) => {
     if (skip) return;
-    test(name, async () => {
-      const suggestions = await getSuggestions(command, process.cwd(), Shell.Bash);
-      if (suggestions != null && suggestions.suggestions != null) {
-        suggestions.suggestions = suggestions?.suggestions.slice(0, maxSuggestions);
-      }
-      expect(suggestions).toMatchSnapshot();
-    });
+    test(
+      name,
+      async () => {
+        const suggestions = await getSuggestions(command, process.cwd(), Shell.Bash);
+        if (suggestions != null && suggestions.suggestions != null) {
+          suggestions.suggestions = suggestions?.suggestions.slice(0, maxSuggestions);
+        }
+        expect(suggestions).toMatchSnapshot();
+      },
+      timeout,
+    );
   });
 });
 
 const subcommandSuggestionsData = [
   {
-    name: "brewInstallMullvad",
-    command: "brew install mullvad-brow",
+    // A formula rather than a cask: `brew casks` needs the online API and returns
+    // nothing on a machine with untrusted taps, so a cask name is a test of the
+    // developer's Homebrew state rather than of the generator.
+    name: "brewInstallWget",
+    command: "brew install wge",
     platforms: ["darwin"],
     maxSuggestions: 1,
-    expectedNames: ["mullvad-browser"],
+    expectedNames: ["wget"],
     // The brew spec supplies a literal 🍺. Whether that survives depends on the
     // active icon style (suppressed under "unicode", which admits no double-width
     // glyphs), so it isn't assertable here — icons.test.ts covers that directly.
diff --git a/src/tests/utils/suggestionRenderer.test.ts b/src/tests/utils/suggestionRenderer.test.ts
index 5bf8aeb..7895e93 100644
--- a/src/tests/utils/suggestionRenderer.test.ts
+++ b/src/tests/utils/suggestionRenderer.test.ts
@@ -24,6 +24,9 @@ const createRenderer = (writeOutput: (data: string) => void) => {
     getCommandState: () => ({ commandText: "g", cursorTerminated: true, hasOutput: false }),
     getCursorState: () => ({ cursorX: 1, cursorY: 0, remainingLines: 28, hidden: false, shift: 0 }),
     getPatch: () => "patch",
+    // Our own command-line highlighting; empty means the overlay adds nothing,
+    // leaving these assertions about the suggestion patch alone.
+    getCommandLinePatch: () => "",
     isAlternateBuffer: () => false,
   } as unknown as ISTerm;
   const suggestions = {
@@ -77,6 +80,9 @@ test("passes data through on direction changes without visible suggestions", ()
     getCommandState: () => ({}),
     getCursorState: () => ({ ...cursor }),
     getPatch: () => "patch",
+    // Our own command-line highlighting; empty means the overlay adds nothing,
+    // leaving these assertions about the suggestion patch alone.
+    getCommandLinePatch: () => "",
     isAlternateBuffer: () => false,
   } as unknown as ISTerm;
   const suggestions = {
