From 43fd1a93e07454cb891c4b609df93b7f0866d98a Mon Sep 17 00:00:00 2001
From: AmirSalahY <amir@noury.ch>
Date: Sat, 8 Aug 2026 04:36:35 +0300
Subject: [PATCH 29/32] feat(alias): cap the recent-commands prompt to the last
 5

Twenty entries was more than anyone reads before picking one; the
frecency list is already sorted most-recent-first, so the extras were
never the more useful ones.
---
 src/commands/alias.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/commands/alias.ts b/src/commands/alias.ts
index bc6938f..975a596 100644
--- a/src/commands/alias.ts
+++ b/src/commands/alias.ts
@@ -57,7 +57,7 @@ const parseParamOptions = (params: string[] | undefined, tokens: string[]): Mana
 };
 
 const chooseRecentCommand = async (rl: readline.Interface): Promise<string[]> => {
-  const commands = await recentCommands();
+  const commands = await recentCommands(5);
   if (commands.length === 0) throw new Error("no recent commands found; pass the command after -- instead");
 
   process.stdout.write("Recent commands:\n");
-- 
