+    // An explicit dismissal lasts for the rest of the line. Enter starts a fresh
+    // line, and Tab is the conventional "complete this" request, so both lift it.
+    // Tab is also swallowed here so it doesn't fall through to the shell's own
+    // completion while the menu is on its way back.
+    // NOT gated on allowBindings: the caller passes renderer.hasVisibleSuggestions,
+    // which is false precisely because the menu is dismissed — gating here would
+    // make the re-open key permanently unreachable.
+    let reopened = false;
+    if (this.#dismissed) {
+      const accept = getConfig().bindings.acceptSuggestion;
+      if (name == "return") {
+        this.#dismissed = false;
+      } else if (name == accept.key && shift == !!accept.shift && ctrl == !!accept.control) {
+        this.#dismissed = false;
+        this.#hideSuggestions = false;
+        reopened = true;
+      }
+    }
+
     // if suggestions are hidden, keep them hidden until during command navigation
     if (this.#hideSuggestions) {
       this.#hideSuggestions = name == "up" || name == "down";
     }
 
+    // Tab that re-opened a dismissed menu is fully handled, even though there is no
+    // suggestion blob yet. It needs an explicit reload request: ui-root only asks
+    // the scheduler when the command-state VERSION changes, and re-opening changes
+    // no screen content, so term.noop() alone leaves the key dead.
+    if (reopened) {
+      this.#reopenRequested = true;
+      return true;
+    }
+
