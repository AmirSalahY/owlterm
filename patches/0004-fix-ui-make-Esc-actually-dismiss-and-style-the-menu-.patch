diff --git a/src/ui/utils.ts b/src/ui/utils.ts
index 4f4c9d7..c991e54 100644
--- a/src/ui/utils.ts
+++ b/src/ui/utils.ts
@@ -6,17 +6,27 @@ import wrapAnsi from "wrap-ansi";
 import chalk from "chalk";
 import { wcswidth } from "../utils/unicode.js";
 
-export const renderBox = (rows: string[], width: number, borderColor?: string): string[] => {
+/** Rounded corners read as a native macOS menu; square is the classic look. */
+const CORNERS = {
+  rounded: { tl: "╭", tr: "╮", bl: "╰", br: "╯" },
+  square: { tl: "┌", tr: "┐", bl: "└", br: "┘" },
+} as const;
+
+export type BoxCorners = keyof typeof CORNERS;
+
+export const renderBox = (rows: string[], width: number, borderColor?: string, corners: BoxCorners = "square"): string[] => {
   const result = [];
   // NB: `chalk.hex(borderColor).apply(text)` would invoke Function.prototype.apply
   // with `text` as thisArg and NO arguments, so chalk returns an empty string and
   // every border character disappears. Call the builder directly.
   const setColor = (text: string) => resetColor + (borderColor ? chalk.hex(borderColor)(text) : text);
-  result.push(setColor("┌" + "─".repeat(width - 2) + "┐"));
+  const { tl, tr, bl, br } = CORNERS[corners] ?? CORNERS.square;
+  const edge = "─".repeat(width - 2);
+  result.push(setColor(tl + edge + tr));
   rows.forEach((row) => {
     result.push(setColor("│") + row + setColor("│"));
   });
-  result.push(setColor("└" + "─".repeat(width - 2) + "┘"));
+  result.push(setColor(bl + edge + br));
   return result;
 };
 
