From 22c44d4d1a0963c32ebf0a82928bc8fba9261f87 Mon Sep 17 00:00:00 2001
From: AmirSalahY <amir@noury.ch>
Date: Thu, 6 Aug 2026 15:23:42 +0300
Subject: [PATCH 25/33] fix(alias): stop quoting the bash binary outside
 windows

The windows fix wrapped the shell path in single quotes so a git bash
install under Program Files survives the spawn. Off windows there is no
shell in front of that spawn, so the quotes end up in the executable
name and every bash alias read dies with ENOENT. The failure is silent:
a non-zero status just yields an empty definition set, so bash users on
linux see no aliases and no complaint. Quote only the windows path.
---
 src/runtime/alias.ts            | 8 ++++++--
 src/tests/runtime/alias.test.ts | 9 +++++++++
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/src/runtime/alias.ts b/src/runtime/alias.ts
index bbb6443..1487aa6 100644
--- a/src/runtime/alias.ts
+++ b/src/runtime/alias.ts
@@ -48,9 +48,13 @@ const bashStartupPrelude = [
 ].join("; ");
 
 const readBashDefinitions = async (): Promise<ShellDefinitions> => {
-  const shellTarget = platform == "win32" ? await gitBashPath() : Shell.Bash;
+  // Windows goes through git bash, so the path needs quoting against spaces.
+  // Everywhere else the command is spawned directly with no shell in front of
+  // it, and quotes would become part of the executable name: spawn ENOENT, no
+  // aliases, no error the user ever sees.
+  const shellTarget = platform == "win32" ? `'${await gitBashPath()}'` : Shell.Bash;
   const { stdout, stderr, status } = await executeShellCommand({
-    command: `'${shellTarget}'`,
+    command: shellTarget,
     // `declare -F` prints "declare -f name"; the prefix is stripped below.
     args: ["--noprofile", "--norc", "-i", "-c", `${bashStartupPrelude}; alias; echo ${functionsMarker}; declare -F`],
     cwd: process.cwd(),
diff --git a/src/tests/runtime/alias.test.ts b/src/tests/runtime/alias.test.ts
index ecdfe74..aea3e34 100644
--- a/src/tests/runtime/alias.test.ts
+++ b/src/tests/runtime/alias.test.ts
@@ -89,6 +89,15 @@ ls='ls --color=auto'`,
     ]);
   });
 
+  test("spawns bash unquoted so posix has an executable to find", async () => {
+    mockGetConfig.mockReturnValue({ useAliases: true });
+    mockExecuteShellCommand.mockReturnValue({ stdout: "", status: 0 });
+
+    await loadAliases(Shell.Bash);
+
+    expect(mockExecuteShellCommand).toHaveBeenCalledWith(expect.objectContaining({ command: "bash" }));
+  });
+
   test("adds bash aliases when the active shell is zsh", async () => {
     mockGetConfig.mockReturnValue({ useAliases: true });
     mockExecuteShellCommand.mockImplementation((options) => {
