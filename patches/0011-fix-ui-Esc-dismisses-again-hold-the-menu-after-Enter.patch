diff --git a/src/tests/keys.test.ts b/src/tests/keys.test.ts
index 26f8d53..200ff91 100644
--- a/src/tests/keys.test.ts
+++ b/src/tests/keys.test.ts
@@ -198,3 +198,106 @@ describe("modifiers are not confused", () => {
     expect(term.written.join("")).toEqual("add ");
   });
 });
+
+describe("Esc dismisses", () => {
+  // Regression guard. readline reports the bare ESC byte as
+  // { name: "escape", meta: true }, because ESC is also the escape-sequence
+  // introducer. A modifier check that compared `meta` therefore never matched the
+  // default `{ key: "escape" }` binding, and Esc silently stopped working.
+  const escape = { name: "escape", sequence: "\u001b", ctrl: false, shift: false, meta: true };
+
+  it("handles Esc even though readline flags it as meta", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("add"), suggestion("branch")]);
+
+    expect(m.update(escape)).toBe(true);
+    expect(m.render("below", 0)).toEqual([]);
+  });
+
+  it("stays dismissed for the rest of the line", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("add")]);
+    m.update(escape);
+
+    // An ordinary keystroke must not bring it back.
+    m.update(press("x"));
+    await m.exec();
+    expect(m.render("below", 0)).toEqual([]);
+  });
+
+  it("reopens on Tab", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("add")]);
+    m.update(escape);
+
+    expect(m.update(press("tab"))).toBe(true);
+    expect(m.takeReopenRequest()).toBe(true);
+  });
+});
+
+describe("menu stays shut after Enter accepts", () => {
+  const enter = press("return");
+
+  it("suppresses the menu so the next Enter submits instead of accepting again", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("status")]);
+
+    expect(m.update(enter)).toBe(true);
+    expect(term.written.join("")).toEqual("status ");
+
+    // Reloading produces no menu, so a second Enter has nothing to accept and
+    // falls through to the shell.
+    await m.exec();
+    expect(m.render("below", 0)).toEqual([]);
+  });
+
+  it("stays shut indefinitely — no timer brings it back on its own", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("status")]);
+    m.update(enter);
+
+    for (let i = 0; i < 3; i++) {
+      await new Promise((r) => setTimeout(r, 20));
+      await m.exec();
+      expect(m.render("below", 0)).toEqual([]);
+    }
+  });
+
+  it("comes back as soon as anything is typed", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("status")]);
+    m.update(enter);
+
+    m.update(press("x"));
+    await m.exec();
+    expect(m.render("below", 0).length).toBeGreaterThan(0);
+  });
+
+  it("counts a space as typing", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("status")]);
+    m.update(enter);
+
+    m.update(press("space"));
+    await m.exec();
+    expect(m.render("below", 0).length).toBeGreaterThan(0);
+  });
+
+  it("does not suppress when Enter had nothing to accept", async () => {
+    const term = makeTerm("git status");
+    const m = await makeManager(term, [suggestion("status")], "status");
+
+    m.update(enter);
+    await m.exec();
+    expect(m.render("below", 0).length).toBeGreaterThan(0);
+  });
+
+  it("does not suppress for Alt+Enter, which is executeSelected", async () => {
+    const term = makeTerm("git ");
+    const m = await makeManager(term, [suggestion("status")]);
+
+    m.update(press("return", { meta: true }));
+    await m.exec();
+    expect(m.render("below", 0).length).toBeGreaterThan(0);
+  });
+});
