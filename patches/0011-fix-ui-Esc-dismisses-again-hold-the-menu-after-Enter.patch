+/**
+ * True when a keypress matches a configured binding, modifiers included.
+ *
+ * `meta` is deliberately ignored for Escape. ESC is both a key and the
+ * introducer for every escape sequence, so readline reports the bare ESC byte as
+ * `{ name: "escape", meta: true }` — the flag says nothing about whether Alt was
+ * held. Comparing it made the default `{ key: "escape" }` binding never match,
+ * which silently disabled dismissal entirely.
+ */
+const matches = (press: KeyPress, binding: Binding | undefined): boolean => {
+  if (binding == null || press.name !== binding.key) return false;
+  if (press.shift !== !!binding.shift || press.ctrl !== !!binding.control) return false;
+  return press.name === "escape" || !!press.meta === !!binding.meta;
+};
 
