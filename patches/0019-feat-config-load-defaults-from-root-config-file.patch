+const defaultConfigFile = "termauto.config.json";
+
+const findDefaultConfigPath = (): string => {
+	const configured = process.env.TERMAUTO_DEFAULT_CONFIG;
+	if (configured && fs.existsSync(configured)) return configured;
+
+	let dir = path.dirname(fileURLToPath(import.meta.url));
+	for (;;) {
+		const candidate = path.join(dir, defaultConfigFile);
+		if (fs.existsSync(candidate)) return candidate;
+		const parent = path.dirname(dir);
+		if (parent === dir) break;
+		dir = parent;
+	}
+	throw new Error(`termauto default config not found: set TERMAUTO_DEFAULT_CONFIG or add ${defaultConfigFile} at the repository root`);
 };
 
+const cloneConfig = (config: Config): Config => JSON.parse(JSON.stringify(config)) as Config;
+
+const readDefaultConfig = (): Config => {
+	const configPath = findDefaultConfigPath();
+	const config = JSON.parse(fs.readFileSync(configPath, "utf-8")) as Config;
+	const isValid = ajv.validate(configSchema, config);
+	if (!isValid) {
+		throw new Error(`${configPath} is invalid: ${ajv.errorsText()}`);
+	}
+	return config;
+};
+
+const defaultConfig = readDefaultConfig();
+let globalConfig: Config = cloneConfig(defaultConfig);
