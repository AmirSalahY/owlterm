From c001a4d20ff21e3853eef364f18602c73c69b326 Mon Sep 17 00:00:00 2001
From: AmirSalahY <amir@noury.ch>
Date: Sun, 9 Aug 2026 12:01:28 +0300
Subject: [PATCH 30/36] fix(shell): don't close the terminal when the engine
 crashes on startup
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Every generated hook unconditionally exited the outer shell after
invoking the engine, on the assumption that returning at all meant the
user cleanly exited their session. A crash (stale build, version
mismatch, missing env var) also returns, and exiting unconditionally
in that case closes the terminal with no prompt left to even run
`owlterm doctor` or `owlterm update` from — which is exactly what
happened across the termauto -> owlterm rebrand: affected users had no
way back into a shell to fix it themselves.

Chain on success (&&, or an explicit exit-code check where the shell
has no && for statements) instead of unconditionally sequencing (;),
so a crash falls through to a normal, working prompt.
---
 src/utils/shell.ts | 26 ++++++++++++++++----------
 1 file changed, 16 insertions(+), 10 deletions(-)

diff --git a/src/utils/shell.ts b/src/utils/shell.ts
index 01cb4fd..9a4aaac 100644
--- a/src/utils/shell.ts
+++ b/src/utils/shell.ts
@@ -305,21 +305,27 @@ export const getShellConfig = (shell: Shell): string => {
   const is = launcherName();
   switch (shell) {
     case Shell.Zsh:
+      // `&&` rather than `;`: a nonzero exit means the engine crashed (a stale
+      // build, a version mismatch, a missing env var) rather than the user
+      // cleanly exiting their session, and unconditionally exiting the outer
+      // shell in that case closes the terminal with no way back in — no prompt
+      // left to even run `owlterm doctor` or `owlterm update` from.
       return `if [[ -z "\${ISTERM}" && $- = *i* && $- != *c* && -z "\${VSCODE_RESOLVING_ENVIRONMENT}" ]]; then
   if [[ -o login ]]; then
-    ${is} -s zsh --login ; exit
+    ${is} -s zsh --login && exit
   else
-    ${is} -s zsh ; exit
+    ${is} -s zsh && exit
   fi
 fi`;
     case Shell.Bash:
+      // See the Zsh case above: `&&` so a crash falls through to a real prompt.
       return `if [[ -z "\${ISTERM}" && $- = *i* && $- != *c* && -z "\${VSCODE_RESOLVING_ENVIRONMENT}" ]]; then
   shopt -q login_shell
   login_shell=$?
   if [ $login_shell -eq 0 ]; then
-    ${is} -s bash --login ; exit
+    ${is} -s bash --login && exit
   else
-    ${is} -s bash ; exit
+    ${is} -s bash && exit
   fi
 fi`;
     case Shell.Powershell:
@@ -329,25 +335,25 @@ $__IsNoExitFlag = ([Environment]::GetCommandLineArgs() | Where-Object { $_ -imat
 $__IsInteractive = -not $__IsCommandFlag -or ($__IsCommandFlag -and $__IsNoExitFlag)
 if ([string]::IsNullOrEmpty($env:ISTERM) -and [Environment]::UserInteractive -and $__IsInteractive -and [string]::IsNullOrEmpty($env:VSCODE_RESOLVING_ENVIRONMENT)) {
   ${is} -s ${shell}
-  Stop-Process -Id $pid
+  if ($LASTEXITCODE -eq 0) { Stop-Process -Id $pid }
 }`;
     case Shell.Fish:
       return `if test -z "$ISTERM" && status --is-interactive && test -z "$VSCODE_RESOLVING_ENVIRONMENT"
   if status --is-login
-    ${is} -s fish --login ; kill %self
+    ${is} -s fish --login && kill %self
   else
-    ${is} -s fish ; kill %self
+    ${is} -s fish && kill %self
   end
 end`;
     case Shell.Xonsh:
       return `if 'ISTERM' not in \${...} and $XONSH_INTERACTIVE and 'VSCODE_RESOLVING_ENVIRONMENT' not in \${...}:
     if $XONSH_LOGIN:
-        ${is} -s xonsh --login ; exit
+        ${is} -s xonsh --login && exit
     else:
-        ${is} -s xonsh ; exit`;
+        ${is} -s xonsh && exit`;
     case Shell.Nushell:
       return `if "ISTERM" not-in $env and $nu.is-interactive and "VSCODE_RESOLVING_ENVIRONMENT" not-in $env {
-    if $nu.is-login { ${is} -s nu --login ; exit } else { ${is} -s nu ; exit }
+    if $nu.is-login { ${is} -s nu --login; if $env.LAST_EXIT_CODE == 0 { exit } } else { ${is} -s nu; if $env.LAST_EXIT_CODE == 0 { exit } }
 }`;
   }
   return "";
