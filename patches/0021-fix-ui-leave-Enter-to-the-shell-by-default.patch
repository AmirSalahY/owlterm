+    expect(m.update(enter)).toBe(false);
+    expect(term.written).toEqual(["<clear>"]);
   });
 
-  it("stays shut indefinitely — no timer brings it back on its own", async () => {
-    const term = makeTerm("git ");
-    const m = await makeManager(term, [suggestion("status")]);
-    m.update(enter);
-
-    for (let i = 0; i < 3; i++) {
-      await new Promise((r) => setTimeout(r, 20));
-      await m.exec();
-      expect(m.render("below", 0)).toEqual([]);
-    }
-  });
-
-  it("comes back as soon as anything is typed", async () => {
