diff --git a/src/ui/suggestionManager.ts b/src/ui/suggestionManager.ts
index d49ed88..bf603a6 100644
--- a/src/ui/suggestionManager.ts
+++ b/src/ui/suggestionManager.ts
@@ -123,15 +123,11 @@ export class SuggestionManager {
    */
   #descriptionHidden: boolean = false;
   /**
-   * Set when Enter accepted a suggestion; keeps the menu shut until the user
-   * types something.
+   * Set when a user configures Enter to accept a suggestion; keeps the menu shut
+   * until the user types something.
    *
-   * Accepting on Enter changes the command line, which immediately produces a new
-   * menu — so the second Enter accepted *that* instead of submitting, and the line
-   * could never be run. Deliberately not time-based: a timer either expires while
-   * you are still deciding, or holds the menu back after you have carried on
-   * typing. "Until the next character" is the condition that actually matters, and
-   * a space counts.
+   * The repo default leaves Enter to the shell, but older configs can still opt
+   * into Enter acceptance through keys.enter/acceptOnEnter.
    */
   #suppressUntilNextInput: boolean = false;
   #abortController?: AbortController;
@@ -494,9 +490,10 @@ export class SuggestionManager {
     // window exists for.
     const isPlainEnter = name === "return" && !ctrl && !shift && !keyPress.meta;
 
-    // Resolved up front because Enter is now overloaded: when it is going to accept
+    // Resolved up front because Enter is configurable: when it is going to accept
     // a suggestion it must NOT clear the command, or it would wipe the very line the
-    // acceptance is about to edit.
+    // acceptance is about to edit. With the default `keys.enter = "ignore"`, this
+    // makes Enter clear our command tracker and then fall through to the shell.
     //
     // insertOrPrefix narrows to the shared prefix while the candidates still
     // disagree, and only commits to the selection once they don't — so an
@@ -515,7 +512,8 @@ export class SuggestionManager {
     // below and wipe the very line it is about to complete.
     const pendingExecute = allowBindings && matches(keyPress, getConfig().bindings.executeSelected) ? this.#pendingAcceptance() : undefined;
 
-    if (name == "return" && acceptance == null && pendingExecute == null) {
+    const shouldClearOnEnter = name == "return" && acceptance == null && pendingExecute == null;
+    if (shouldClearOnEnter) {
       this.#term.clearCommand(); // clear the current command on enter
     }
 
@@ -596,7 +594,9 @@ export class SuggestionManager {
       this.#term.write(applyReplacement(acceptance));
       // Hold the menu shut so the next Enter reaches the shell and runs the line.
       if (isPlainEnter) this.#suppressUntilNextInput = true;
-    } else if (name == "return" || (name == "c" && ctrl)) {
+    } else if (name == "return") {
+      return false;
+    } else if (name == "c" && ctrl) {
       this.#term.clearCommand();
       return false;
     } else {
