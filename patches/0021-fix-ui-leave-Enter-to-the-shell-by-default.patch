+    expect(term.written).toEqual(["<clear>"]);
   });
 
-  it("does not suppress for Alt+Enter, which is executeSelected", async () => {
+  it("does not interfere with Alt+Enter, which is executeSelected", async () => {
     const term = makeTerm("git ");
     const m = await makeManager(term, [suggestion("status")]);
 
-    m.update(press("return", { meta: true }));
