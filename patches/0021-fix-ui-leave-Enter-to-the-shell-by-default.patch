From c07a72f588bd77f1d105e1d61b73c1933f15e914 Mon Sep 17 00:00:00 2001
From: AmirSalahY <amir@noury.ch>
Date: Wed, 5 Aug 2026 10:23:53 +0300
Subject: [PATCH 21/36] fix(ui): leave Enter to the shell by default

---
 src/index.ts                |  8 ++---
 src/tests/keys.test.ts      | 59 +++++++------------------------------
 src/ui/suggestionManager.ts | 24 +++++++--------
 3 files changed, 26 insertions(+), 65 deletions(-)

diff --git a/src/index.ts b/src/index.ts
index 1972657..bea97f8 100644
--- a/src/index.ts
+++ b/src/index.ts
@@ -33,7 +33,7 @@ const hiddenOption = (flags: string, description: string) => {
 const keybindingHelp = () => `
 Keys (while the suggestion menu is open):
   Tab                accept the highlighted suggestion
-  Enter              accept, then Enter again to run
+  Enter              run the command, ignoring the suggestion menu
   Right              accept, only with the cursor at end of line
   Up / Down          move the selection
   Esc                dismiss for the rest of the line; Tab reopens
@@ -50,9 +50,9 @@ Suggestion order (sortMethod):
   alphabetical       by name, ignoring usage
   none               spec-declared priority only
 
-After Enter accepts a suggestion the menu stays shut until you type something —
-a space counts — so a second Enter runs the line rather than accepting whatever
-would have reopened.
+Enter is deliberately left to the shell so a visible suggestion cannot block
+submitting the command. Use Tab to accept or Alt+Enter to accept and run in one
+keystroke.
 
 Configure the rest in ~/.config/inshellisense/rc.toml, under [bindings], [keys]
 and sortMethod. Alt+letter, Alt+digit and Alt+Enter are the only Alt combinations a
