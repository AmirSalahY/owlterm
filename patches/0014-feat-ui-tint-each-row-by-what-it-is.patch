diff --git a/src/ui/suggestionManager.ts b/src/ui/suggestionManager.ts
index 7e69f24..379374b 100644
--- a/src/ui/suggestionManager.ts
+++ b/src/ui/suggestionManager.ts
@@ -269,8 +269,21 @@ export class SuggestionManager {
   }
 
   private _renderSuggestions(suggestions: Suggestion[], activeSuggestionIdx: number) {
-    const { activeBackground, activeForeground, foreground, icon: iconColor, pointer } = getConfig().theme;
+    const { activeBackground, activeForeground, foreground, icon: iconColor, pointer, colorByType, types } = getConfig().theme;
     const inner = suggestionWidth - borderWidth;
+
+    /**
+     * Row colour for an unselected suggestion.
+     *
+     * Falls back to `foreground` for an unknown or uncoloured kind, and for an
+     * empty string — which is how a type opts out of tinting (files, by default).
+     */
+    const labelColor = (type: Suggestion["type"]): string => {
+      if (!colorByType || type == null) return foreground;
+      const tint = types[type as keyof typeof types];
+      return tint ? tint : foreground;
+    };
+
     return renderBox(
       suggestions.map((suggestion, idx) => {
         const active = idx == activeSuggestionIdx;
@@ -291,7 +304,10 @@ export class SuggestionManager {
             .hex(activeForeground)
             .bold(prefix + label);
         }
-        return chalk.hex(iconColor)(prefix) + chalk.hex(foreground)(label);
+        // Only the label is tinted. The icon column keeps its own dim grey: the
+        // glyph already encodes the kind by shape, and colouring both made the
+        // row read as two competing highlights instead of one label.
+        return chalk.hex(iconColor)(prefix) + chalk.hex(labelColor(suggestion.type))(label);
       }),
       suggestionWidth,
       this._boxStyle(),
