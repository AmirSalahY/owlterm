diff --git a/src/tests/colors.test.ts b/src/tests/colors.test.ts
new file mode 100644
index 0000000..7b24604
--- /dev/null
+++ b/src/tests/colors.test.ts
@@ -0,0 +1,150 @@
+// Copyright (c) Microsoft Corporation.
+// Licensed under the MIT License.
+
+// Type colouring: rows are tinted by what they are, so a folder, a file and a
+// subcommand are distinguishable at a glance.
+//
+// Two separate things are covered, because the feature failed at the first for a
+// long time without anyone noticing:
+//
+//   1. `Suggestion.type` actually being populated. It used to store the raw
+//      spec value, which is almost always absent — the real kind arrives as a
+//      contextual argument — so every row looked untyped and any colouring would
+//      silently have painted one flat colour.
+//   2. the renderer emitting a different colour per kind.
+
+import chalk from "chalk";
+
+import { getSuggestions } from "../runtime/runtime.js";
+import { getConfig, loadConfig } from "../utils/config.js";
+import { Shell } from "../utils/shell.js";
+import { unpackResources } from "../utils/node.js";
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+const loadDefaults = () => loadConfig({ opts: () => ({}) } as any);
+
+/**
+ * Force truecolour. Under jest there is no TTY, so chalk defaults to level 0 and
+ * strips every escape — which would make the positive assertions fail and, worse,
+ * make the `not.toContain` one pass for the wrong reason.
+ */
+let previousLevel: typeof chalk.level;
+
+beforeAll(async () => {
+  previousLevel = chalk.level;
+  chalk.level = 3;
+  await unpackResources();
+  await loadDefaults();
+});
+
+afterAll(() => {
+  chalk.level = previousLevel;
+});
+
+/** The truecolour SGR chalk emits for a hex value, so tests assert on real output. */
+const fg = (hex: string): string => {
+  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
+  return `[38;2;${r};${g};${b}m`;
+};
+
+const typesOf = async (input: string): Promise<Set<string | undefined>> => {
+  const result = await getSuggestions(input, process.cwd(), Shell.Zsh);
+  return new Set((result?.suggestions ?? []).map((s) => s.type));
+};
+
+describe("suggestion type is resolved, not just copied", () => {
+  it("types subcommands", async () => {
+    expect(await typesOf("git ")).toContain("subcommand");
+  });
+
+  it("types options", async () => {
+    expect(await typesOf("git -")).toContain("option");
+  });
+
+  it("distinguishes files from folders in one listing", async () => {
+    const types = await typesOf("cat ");
+    expect([types.has("file"), types.has("folder")]).toEqual([true, true]);
+  });
+
+  // The bug this guards: `type` was read straight off the spec's suggestion
+  // object, where it is almost never set, while the icon used the contextual
+  // fallback. The two must agree, or the colour contradicts the glyph.
+  it("agrees with the icon that was chosen for the same row", async () => {
+    const { suggestions } = (await getSuggestions("cat ", process.cwd(), Shell.Zsh)) ?? { suggestions: [] };
+    const folderIcon = suggestions.find((s) => s.type === "folder")?.icon;
+    const fileIcon = suggestions.find((s) => s.type === "file")?.icon;
+    expect(folderIcon).not.toEqual(fileIcon);
+  });
+});
+
+describe("row colouring", () => {
+  // Reaching past the constructor: SuggestionManager needs a live PTY, and none
+  // of that is involved in turning a list of suggestions into styled strings.
+  const render = async (suggestions: { name: string; type?: string }[]): Promise<string> => {
+    const { SuggestionManager } = await import("../ui/suggestionManager.js");
+    const rows = Object.create(SuggestionManager.prototype)._renderSuggestions(
+      suggestions.map((s) => ({ ...s, icon: "", allNames: [s.name], priority: 50 })),
+      // -1 so no row is selected: the selection bar paints one solid colour over
+      // gutter, icon and label by design, which would mask the tint under test.
+      -1,
+    );
+    return Array.isArray(rows) ? rows.join("") : String(rows);
+  };
+
+  it("gives folders, subcommands and options each a different colour", async () => {
+    const { types } = getConfig().theme;
+    const output = await render([
+      { name: "adir", type: "folder" },
+      { name: "asub", type: "subcommand" },
+      { name: "--anopt", type: "option" },
+    ]);
+    expect(output).toContain(fg(types.folder));
+    expect(output).toContain(fg(types.subcommand));
+    expect(output).toContain(fg(types.option));
+  });
+
+  it("leaves files at the default foreground", async () => {
+    const { foreground, types } = getConfig().theme;
+    // Files are deliberately uncoloured — they are the commonest row, so tinting
+    // the baseline would leave nothing to contrast against.
+    expect(types.file).toEqual("");
+    expect(await render([{ name: "a.txt", type: "file" }])).toContain(fg(foreground));
+  });
+
+  it("falls back to the foreground for an untyped row", async () => {
+    // Real case: `npm run <TAB>` script names are arbitrary strings, neither file
+    // nor folder nor command, and arrive with no type at all.
+    const { foreground } = getConfig().theme;
+    expect(await render([{ name: "build" }])).toContain(fg(foreground));
+  });
+
+  it("paints every row the foreground when colorByType is off", async () => {
+    const theme = getConfig().theme;
+    const previous = theme.colorByType;
+    theme.colorByType = false;
+    try {
+      const output = await render([
+        { name: "adir", type: "folder" },
+        { name: "asub", type: "subcommand" },
+      ]);
+      expect(output).toContain(fg(theme.foreground));
+      expect(output).not.toContain(fg(theme.types.folder));
+      expect(output).not.toContain(fg(theme.types.subcommand));
+    } finally {
+      theme.colorByType = previous;
+    }
+  });
+});
+
+describe("theme.types config", () => {
+  // The rc schema sets additionalProperties: false on this table, so a plausible
+  // wrong guess like `directory = "#fff"` is rejected at load rather than parsing
+  // cleanly and colouring nothing — a config that looks applied but isn't.
+  // loadConfig reads fixed paths under the real home directory and can't be
+  // pointed elsewhere, so the schema itself isn't reachable from here; what is
+  // checkable is that the defaults cover exactly Fig's type union, which is what
+  // the schema is written against.
+  it("covers exactly the Fig suggestion types", () => {
+    expect(Object.keys(getConfig().theme.types).sort()).toEqual(["arg", "file", "folder", "mixin", "option", "shortcut", "special", "subcommand"]);
+  });
+});
